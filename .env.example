# ==============================================================================
# LATENT 環境變數設定檔 (.env.example)
# 請複製此檔案並重新命名為 .env，然後填寫以下對應的真實金鑰。
# 警告：絕對不要將填有真實金鑰的 .env 檔案推送到 GitHub！
# ==============================================================================

# ── Supabase (前端公開) ───────────────────────────────────────────────────────
# 取得位置：Supabase Dashboard -> Project Settings -> API
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJh..."

# ── Supabase Service Role (伺服器端，絕對勿洩漏給前端) ─────────────────────────
SUPABASE_SERVICE_ROLE_KEY="eyJh..."

# ── Cloudflare R2 S3 API 憑證 ────────────────────────────────────────────────
# 取得位置：Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your_account_id_here"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="latent-images"

# ── 圖片公開讀取 URL ──────────────────────────────────────────────────────────
# R2 Bucket 綁定的公開自訂網域或 dev.r2 網域。
# 提示：網址結尾「不要」加斜線 (/)，例如：https://cdn.yourdomain.com
PUBLIC_R2_CDN_URL="https://pub-xxxxxxxx.r2.dev"

# ── 網站基本網址 ─────────────────────────────────────────────────────────────
# 用於 OAuth 登入回調 (Redirect URI) 與部分絕對路徑生成。
# 本地開發請填：http://localhost:8888 (若是 Netlify dev 預設 port)
# 生產環境請填：https://your-production-site.com (結尾不加斜線)
PUBLIC_SITE_URL="http://localhost:8888"

# ── 背景函式內部驗證 Token ───────────────────────────────────────────────────
# 確保只有 API 路由可以呼叫你的背景處理函式 (Background Function)。
# 提示：隨便打一串複雜的英數隨機字串即可，例如：my_super_secret_token_123
INTERNAL_TOKEN="generate_a_random_string_here"

# ── Umami 網站流量分析 (伺服器端抓取 View 次數用) ──────────────────────────────
# 取得位置：Umami Dashboard -> Profile -> API client API key
UMAMI_API_CLIENT_TOKEN="api_key_..."
# 取得位置：Umami Dashboard -> Websites -> Edit -> Website ID (UUID 格式)
UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Umami 的 API 節點，若為自託管請填寫自託管網址 (結尾不加斜線)
UMAMI_API_ENDPOINT="https://api.umami.is/v1"