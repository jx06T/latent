---
export const prerender = false
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <title>登入中…</title>
    <style>
      body { margin: 0; display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #0a0a0a; font-family: monospace; color: #888; font-size: 12px; }
    </style>
  </head>
  <body>
    <span>Signing in…</span>
    <script>
      import { supabase } from '@/lib/supabase'

      // Capture next BEFORE Supabase cleans the URL via history.replaceState
      const params = new URLSearchParams(window.location.search)
      const raw = params.get('next') || '/'
      const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/'

      // Prevent double-redirect when both INITIAL_SESSION and SIGNED_IN fire
      let redirected = false

      async function resolveAndRedirect(userId: string) {
        if (redirected) return
        redirected = true

        try {
          const { data } = await supabase
            .from('profiles')
            .select('is_onboarded')
            .eq('id', userId)
            .maybeSingle()

          const dest = (!data || !data.is_onboarded)
            ? `/onboarding?next=${encodeURIComponent(next)}`
            : next

          window.location.replace(dest)
        } catch {
          // On any error, still redirect so the user isn't stranded
          window.location.replace(next)
        }
      }

      // Single source of truth: onAuthStateChange handles both cases:
      //   INITIAL_SESSION  → user was already signed in (e.g. page refresh)
      //   SIGNED_IN        → new OAuth login just completed (PKCE exchange done)
      // We deliberately avoid a parallel getSession() call to eliminate the
      // race condition where getSession() resolves with a stale/prior session
      // before the PKCE exchange finishes, triggering a premature redirect.
      supabase.auth.onAuthStateChange((event, session) => {
        if (session && (event === 'SIGNED_IN' || event === 'INITIAL_SESSION')) {
          resolveAndRedirect(session.user.id)
        }
      })
    </script>
  </body>
</html>
