---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 — 找不到頁面" description="這個頁面不存在或已被移除。">
  <main
    class="flex-1 flex flex-col items-center justify-center gap-8 px-6 py-24 font-mono w-full h-[70vh]"
  >
    <div class="text-center space-y-3 text-6xl">
      <p class="font-bold text-accent-500 leading-none">404</p>
      <p class="text-ink-dim text-base tracking-widest uppercase">找不到頁面</p>
    </div>

    <div class="flex flex-wrap gap-3 justify-center">
      <a
        href="/"
        class="inline-flex items-center justify-center gap-1.5 border px-3.5 py-2 text-sm tracking-widest uppercase font-mono transition-colors duration-150 text-ink-muted border-line hover:border-line-active hover:text-ink"
      >
        回到首頁
      </a>
      <a
        href="/projects"
        class="inline-flex items-center justify-center gap-1.5 border px-3.5 py-2 text-sm tracking-widest uppercase font-mono transition-colors duration-150 text-ink-muted border-line hover:border-line-active hover:text-ink"
      >
        回到專案頁
      </a>
    </div>
  </main>
</Layout>
