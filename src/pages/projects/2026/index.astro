---
import Layout from "@/layouts/Layout.astro";
import CommentLabel from "@/components/ui/CommentLabel";
import { Input } from "@/components/ui/Input";
import ProjectCard from "@/components/modules/ProjectCard";
import { supabase } from "@/lib/supabase";
import { ProjectSchema, CATEGORIES } from "@/lib/schema";
import { SITE_TITLE } from "@/consts";
import { z } from "zod";
import { publishedUrl, type ProjectImageRow } from "@/lib/image-paths";

const { data, error } = await supabase
  .from("projects")
  .select("*")
  .eq("year", 2026)
  .eq("status", "published")
  .order("created_at", { ascending: false });

if (error) {
  console.error("Fetch error:", error);
}

const projects = z.array(ProjectSchema).parse(data || []);

// Bulk-resolve cover images in a single query
const coverIds = projects.map(p => p.cover_image_id).filter(Boolean) as string[]
const coverUrlMap: Record<string, string> = {}
if (coverIds.length > 0) {
  const { data: coverImgs } = await supabase
    .from("project_images")
    .select("id, project_id, status, source_ext, published_ext, available_sizes")
    .in("id", coverIds)
    .eq("status", "published")
  for (const img of coverImgs ?? []) {
    try { coverUrlMap[img.id] = publishedUrl(img as unknown as ProjectImageRow, "md") } catch {}
  }
}

const YEAR = 2026;
const allCategories = Object.entries(CATEGORIES) as [string, string][];
---

<Layout
  title={`Projects-${YEAR} | ${SITE_TITLE}`}
  description={`探索 ${YEAR} 年度學生專題，涵蓋 AI、系統開發、互動遊戲等領域`}
  activeNav="projects"
>
  <main class="pt-12 min-h-screen">
    <!-- Page header -->
    <section
      class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-8 border-b border-line"
    >
      <!-- <CommentLabel text="year_database" /> -->
      <h1
        class="text-4xl sm:text-5xl font-black text-ink text-glow-primary mt-2 tracking-tight"
      >
        [ PROJECT_{YEAR} ]
      </h1>
      <div
        class="flex flex-wrap items-center gap-4 mt-3 font-mono text-sm text-ink-dim"
      >
        <span
          >TOTAL_RECORDS: <span class="text-ink-muted ">{projects.length}</span></span
        >
        <span class="text-line-active">│</span>
        <span>STATUS: <span class="text-accent-600">PUBLISHED</span></span>
      </div>
    </section>

    <!-- Search & filter hook (data attributes ready for future JS wiring) -->
    <section
      id="search-interface"
      class="max-w-6xl mx-auto px-4 xs:px-6 sm:px-10 py-6 border-b border-line"
    >
      <div class="flex flex-col sm:flex-row gap-4">
        <div class="flex-1">
          <CommentLabel text="query_filter" />
          <Input variant="terminal" id="search-input" placeholder="search title, author, keyword..." wrapperClassName="w-full" />
        </div>
      </div>

      <!-- Category filter buttons -->
      <div id="category-filters" class="flex flex-wrap gap-2 mt-4">
        <button
          data-category="all"
          class="font-mono text-xs px-3 py-1.5 border border-line-active text-accent-500
                   hover:bg-accent-500/10 transition-colors duration-150
                   [&.active]:bg-accent-500/20 [&.active]:border-accent-500 active"
        >
          全部
        </button>
        {
          allCategories.map(([id, label]) => (
            <button
              data-category={id}
              class="font-mono text-xs px-3 py-1.5 border border-line text-ink-dim
                     hover:border-line-active hover:text-ink transition-colors duration-150
                     [&.active]:bg-accent-500/20 [&.active]:border-accent-500 [&.active]:text-accent-500"
            >
              {label}
            </button>
          ))
        }
      </div>
    </section>

    <!-- Project grid -->
    <section class="max-w-6xl mx-auto px-4 xs:px-6 sm:px-10 py-8 pb-24">
      {
        projects.length === 0 ? (
          <div class="flex flex-col items-center justify-center py-24 text-center border-dashed-cyber">
            <CommentLabel text="no_records_found" />
            <p class="font-mono text-ink-dim mt-4">// 目前尚無已發佈的專題</p>
          </div>
        ) : (
          <div id="no-results" class="hidden py-24 text-center">
            <p class="font-mono text-ink-dim">// NO_RESULTS_FOUND</p>
          </div>
          <ul
            id="project-grid"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
          >
            {projects.map((project) => (
              <li
                data-title={project.title.toLowerCase()}
                data-author={project.author_handle.toLowerCase()}
                data-category={project.category_main}
                data-keywords={project.keywords.join(" ").toLowerCase()}
                data-subtitle={(project.subtitle ?? "").toLowerCase()}
                data-tech={project.tech_stack.join(" ").toLowerCase()}
                data-description={(project.description ?? "").toLowerCase()}
              >
                <ProjectCard
                  slug={project.slug}
                  year={YEAR}
                  title={project.title}
                  subtitle={project.subtitle}
                  author_handle={project.author_handle}
                  category_main={project.category_main}
                  cover_image={project.cover_image_id ? (coverUrlMap[project.cover_image_id] ?? null) : null}
                  tech_stack={project.tech_stack}
                  like_count={project.like_count}
                />
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>("#category-filters [data-category]");
  const grid = document.getElementById("project-grid");
  const noResults = document.getElementById("no-results");

  // Snapshot with original index for stable sort restoration
  const items = Array.from(document.querySelectorAll<HTMLLIElement>("#project-grid li"))
    .map((li, i) => ({ li, i }));

  let activeCategory = "all";

  function scoreItem(terms: string[], li: HTMLLIElement): number {
    const fields = [
      li.dataset.title, li.dataset.author, li.dataset.keywords,
      li.dataset.subtitle, li.dataset.tech, li.dataset.description,
    ];
    return terms.filter((t) => fields.some((f) => (f ?? "").includes(t))).length;
  }

  function applyFilters() {
    const terms = (searchInput?.value.toLowerCase() ?? "").split(/\s+/).filter(Boolean);

    const scored = items.map(({ li, i }) => ({
      li, i,
      score: scoreItem(terms, li),
      cat: activeCategory === "all" || li.dataset.category === activeCategory,
    }));

    // Higher score first; ties preserve original order (score=0 when no query → full original order)
    scored.sort((a, b) => b.score - a.score || a.i - b.i);
    scored.forEach(({ li }) => grid?.appendChild(li));

    let visible = 0;
    scored.forEach(({ li, score, cat }) => {
      const show = cat && (terms.length === 0 || score > 0);
      li.classList.toggle("hidden", !show);
      if (show) visible++;
    });

    noResults?.classList.toggle("hidden", visible > 0);
    updateUrl();
  }

  function updateUrl() {
    const params = new URLSearchParams();
    const q = searchInput?.value.trim();
    if (q) params.set("q", q);
    if (activeCategory !== "all") params.set("cat", activeCategory);
    const qs = params.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  searchInput?.addEventListener("input", applyFilters);

  categoryButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = btn.dataset.category ?? "all";
      categoryButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      applyFilters();
    });
  });

  // Restore state from URL on page load
  const urlParams = new URLSearchParams(location.search);
  const initQ = urlParams.get("q") ?? "";
  const initCat = urlParams.get("cat") ?? "all";
  if (searchInput && initQ) searchInput.value = initQ;
  if (initCat !== "all") {
    activeCategory = initCat;
    categoryButtons.forEach((b) => b.classList.toggle("active", b.dataset.category === initCat));
  }
  if (initQ || initCat !== "all") applyFilters();
</script>
