---
import Layout from "@/layouts/Layout.astro";
import CommentLabel from "@/components/ui/CommentLabel";
import { Input } from "@/components/ui/Input";
import ProjectCard from "@/components/modules/ProjectCard";
import { supabase } from "@/lib/supabase";
import { ProjectSchema, CATEGORIES } from "@/lib/schema";
import { SITE_TITLE } from "@/consts";
import { z } from "zod";
import { publishedUrl, type ProjectImageRow } from "@/lib/image-paths";

// 1. 合併查詢：利用 Supabase 的關聯查詢功能一次抓完專案與圖片
// 2. 精確欄位：只抓取 UI 需要的欄位，大幅減少傳輸量
const { data, error } = await supabase
  .from("projects")
  .select(`
    slug, title, subtitle, author_handle, category_main, 
    tech_stack, like_count, is_official, is_exhibition,
    cover_image_id, created_at, updated_at, keywords, description,
    cover:project_images!projects_cover_image_id_fkey (
      id, project_id, status, source_ext, published_ext, available_sizes
    )
  `)
  .eq("year", 2026)
  .eq("status", "published")
  .order("created_at", { ascending: false });

if (error) console.error("Fetch error:", error);

// 3. 定義一個專門處理「包含封面與預設值」的 Schema
const ProjectDisplaySchema = ProjectSchema.extend({
  // 擴大 Schema 以接收 Supabase Join 進來的 cover 物件
  cover: z.any().nullable().optional(),
}).transform((p) => {
  let coverUrl: string | null = null;
  // 防禦性產生 URL：確保產圖邏輯出錯時不影響整頁渲染
  try {
    if (p.cover && (p.cover as any).id && (p.cover as any).project_id) {
      coverUrl = publishedUrl(p.cover as any, "md");
    }
  } catch (e) {
    console.warn(`[ProjectDisplaySchema] Failed to resolve cover for ${p.slug}:`, e);
  }
  return { ...p, coverUrl };
});

// 4. 使用 safeParse 避免單一資料錯誤導致整個頁面崩潰
const parsedResult = z.array(ProjectDisplaySchema).safeParse(data || []);
if (!parsedResult.success) {
  console.error("[ProjectPage] Data validation failed:", parsedResult.error);
}
const projects = parsedResult.success ? parsedResult.data : [];

const YEAR = 2026;
const allCategories = Object.entries(CATEGORIES) as [string, string][];
const tagBase =  `font-mono text-xs px-3 py-1.5 border border-line text-ink-dim
                     hover:border-line-active hover:text-ink transition-colors duration-150
                     [&.active]:bg-accent-500/20 [&.active]:border-accent-500 [&.active]:text-accent-500`
---

<Layout
  title={`Projects-${YEAR} | ${SITE_TITLE}`}
  description={`探索 ${YEAR} 年度學生專題，涵蓋 AI、系統開發、互動遊戲等領域`}
  activeNav="projects"
>
  <main class="pt-12 min-h-screen">
    <!-- Page header -->
    <section
      class="max-w-6xl mx-auto px-4 sm:px-6 pt-12 pb-8 border-b border-line"
    >
      <!-- <CommentLabel text="year_database" /> -->
      <h1
        class="text-4xl sm:text-5xl font-black text-ink text-glow-primary mt-2 tracking-tight"
      >
        [ PROJECT_{YEAR} ]
      </h1>
      <div
        class="flex flex-wrap items-center gap-4 mt-3 font-mono text-sm text-ink-dim"
      >
        <span
          >TOTAL_RECORDS: <span class="text-ink-muted ">{projects.length}</span></span
        >
        <span class="text-line-active">│</span>
        <span>STATUS: <span class="text-accent-600">PUBLISHED</span></span>
      </div>
    </section>

    <!-- Search & filter hook (data attributes ready for future JS wiring) -->
    <section
      id="search-interface"
      class="max-w-6xl mx-auto px-4 xs:px-6 sm:px-10 py-6 border-b border-line"
    >
      <div class="flex flex-col sm:flex-row gap-4">
        <div class="flex-1">
          <CommentLabel text="query_filter" />
          <Input variant="terminal" id="search-input" placeholder="search title, author, keyword..." wrapperClassName="w-full" />
        </div>
      </div>

      <!-- Category filter buttons -->
      <div id="category-filters" class="flex flex-wrap gap-2 mt-4">
        <button
          data-category="all"
          class={tagBase}
        >
          全部
        </button>
        {
          allCategories.map(([id, label]) => (
            <button
              data-category={id}
                       class={tagBase}

            >
              {label}
            </button>
          ))
        }
      </div>

      <!-- Official tag filters + sort -->
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t mt-4 py-3 border-line">
        <!-- left: official / exhibition -->
        <div class="flex items-center gap-3">
          <div id="official-filters" class="flex gap-2">
            <button data-official="all" class={tagBase}>全部</button>
            <button data-official="true" class={tagBase}>官方</button>
            <button data-official="false" class={tagBase}>社區</button>
          </div>
          <div class="w-px h-5 bg-line shrink-0"></div>
          <button id="exhibition-filter" class={tagBase}>現場展覽</button>
        </div>
        <!-- right: sort -->
        <div class="flex items-center gap-2">
          <span class="font-mono text-[10px] text-ink-ddim tracking-widest">SORT</span>
          <div id="sort-buttons" class="flex gap-2">
            <button data-sort="title" class={tagBase}>名稱<span class="sort-dir"></span></button>
            <button data-sort="updated" class={tagBase}>更新日期<span class="sort-dir"></span></button>
            <button data-sort="likes" class={tagBase}>按讚數<span class="sort-dir"></span></button>
          </div>
        </div>
      </div>
    </section>

    <!-- Project grid -->
    <section class="max-w-6xl mx-auto px-4 xs:px-6 sm:px-10 py-8 pb-24">
      {
        projects.length === 0 ? (
          <div class="flex flex-col items-center justify-center py-24 text-center border-dashed-cyber">
            <CommentLabel text="no_records_found" />
            <p class="font-mono text-ink-dim mt-4">// 目前尚無已發佈的專題</p>
          </div>
        ) : (
          <div id="no-results" class="hidden py-24 text-center">
            <p class="font-mono text-ink-dim">// NO_RESULTS_FOUND</p>
          </div>
          <ul
            id="project-grid"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
          >
            {projects.map((project) => (
              <li
                data-title={project.title.toLowerCase()}
                data-author={project.author_handle.toLowerCase()}
                data-category={project.category_main}
                data-keywords={project.keywords.join(" ").toLowerCase()}
                data-subtitle={project.subtitle.toLowerCase()}
                data-tech={project.tech_stack.join(" ").toLowerCase()}
                data-description={project.description.toLowerCase()}
                data-official={String(project.is_official)}
                data-exhibition={String(project.is_exhibition)}
                data-likes={project.like_count}
                data-updated={new Date(project.updated_at ?? project.created_at).getTime()}
              >
                <ProjectCard
                  slug={project.slug}
                  year={YEAR}
                  title={project.title}
                  subtitle={project.subtitle}
                  author_handle={project.author_handle}
                  category_main={project.category_main}
                  cover_image={project.coverUrl}
                  tech_stack={project.tech_stack}
                  like_count={project.like_count}
                  is_official={project.is_official}
                  is_exhibition={project.is_exhibition}
                />
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>("#category-filters [data-category]");
  const officialButtons = document.querySelectorAll<HTMLButtonElement>("#official-filters [data-official]");
  const sortButtons = document.querySelectorAll<HTMLButtonElement>("#sort-buttons [data-sort]");
  const exhibitionBtn = document.getElementById("exhibition-filter") as HTMLButtonElement | null;
  const grid = document.getElementById("project-grid");
  const noResults = document.getElementById("no-results");

  const items = Array.from(document.querySelectorAll<HTMLLIElement>("#project-grid li"))
    .map((li, i) => ({ li, i }));

  let activeCategory = "all";
  let activeOfficial = "all";   // "all" | "true" | "false"
  let filterExhibition = false;
  let activeSort = "";           // "" | "title" | "updated" | "likes"
  let sortDir: "asc" | "desc" = "asc";

  const defaultDir: Record<string, "asc" | "desc"> = {
    title: "asc",
    updated: "desc",
    likes: "desc",
  };

  function scoreItem(terms: string[], li: HTMLLIElement): number {
    const fields = [
      li.dataset.title, li.dataset.author, li.dataset.keywords,
      li.dataset.subtitle, li.dataset.tech, li.dataset.description,
    ];
    return terms.filter((t) => fields.some((f) => (f ?? "").includes(t))).length;
  }

  function compareItems(
    a: { li: HTMLLIElement; i: number; score: number },
    b: { li: HTMLLIElement; i: number; score: number },
    terms: string[],
  ): number {
    // search score takes priority when a query exists
    if (terms.length > 0 && a.score !== b.score) return b.score - a.score;
    const d = sortDir === "asc" ? 1 : -1;
    switch (activeSort) {
      case "title":
        return d * (a.li.dataset.title ?? "").localeCompare(b.li.dataset.title ?? "");
      case "updated":
        return d * (Number(a.li.dataset.updated ?? 0) - Number(b.li.dataset.updated ?? 0));
      case "likes":
        return d * (Number(a.li.dataset.likes ?? 0) - Number(b.li.dataset.likes ?? 0));
      default:
        return a.i - b.i;
    }
  }

  function applyFilters() {
    const terms = (searchInput?.value.toLowerCase() ?? "").split(/\s+/).filter(Boolean);

    const scored = items.map(({ li, i }) => ({
      li, i,
      score: scoreItem(terms, li),
      cat: activeCategory === "all" || li.dataset.category === activeCategory,
      official: activeOfficial === "all" || li.dataset.official === activeOfficial,
      exhibition: !filterExhibition || li.dataset.exhibition === "true",
    }));

    scored.sort((a, b) => compareItems(a, b, terms));
    scored.forEach(({ li }) => grid?.appendChild(li));

    let visible = 0;
    scored.forEach(({ li, score, cat, official, exhibition }) => {
      const show = cat && official && exhibition && (terms.length === 0 || score > 0);
      li.classList.toggle("hidden", !show);
      if (show) visible++;
    });

    noResults?.classList.toggle("hidden", visible > 0);
    updateUrl();
  }

  function updateUrl() {
    const params = new URLSearchParams();
    const q = searchInput?.value.trim();
    if (q) params.set("q", q);
    if (activeCategory !== "all") params.set("cat", activeCategory);
    if (activeOfficial !== "all") params.set("official", activeOfficial);
    if (filterExhibition) params.set("exhibition", "1");
    if (activeSort) { params.set("sort", activeSort); params.set("dir", sortDir); }
    const qs = params.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  searchInput?.addEventListener("input", applyFilters);

  categoryButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = btn.dataset.category ?? "all";
      categoryButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      applyFilters();
    });
  });

  officialButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeOfficial = btn.dataset.official ?? "all";
      officialButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      applyFilters();
    });
  });

  function updateSortButtons() {
    sortButtons.forEach((b) => {
      const s = b.dataset.sort ?? "";
      const isActive = s === activeSort && activeSort !== "";
      b.classList.toggle("active", isActive);
      const indicator = b.querySelector(".sort-dir") as HTMLElement | null;
      if (indicator) indicator.textContent = isActive ? (sortDir === "asc" ? " ↑" : " ↓") : "";
    });
  }

  // sort: 1st click = activate (default dir), 2nd click = flip dir, 3rd click = deactivate
  sortButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const s = btn.dataset.sort ?? "";
      if (activeSort === s) {
        if (sortDir !== defaultDir[s]) {
          activeSort = "";
        } else {
          sortDir = sortDir === "asc" ? "desc" : "asc";
        }
      } else {
        activeSort = s;
        sortDir = defaultDir[s] ?? "asc";
      }
      updateSortButtons();
      applyFilters();
    });
  });

  exhibitionBtn?.addEventListener("click", () => {
    filterExhibition = !filterExhibition;
    exhibitionBtn.classList.toggle("active", filterExhibition);
    applyFilters();
  });

  // Restore state from URL on page load
  const urlParams = new URLSearchParams(location.search);
  const initQ = urlParams.get("q") ?? "";
  const initCat = urlParams.get("cat") ?? "all";
  const initOfficial = urlParams.get("official") ?? "all";
  const initExhibition = urlParams.get("exhibition") === "1";
  const initSort = urlParams.get("sort") ?? "";
  const initDir = urlParams.get("dir") as "asc" | "desc" | null;
  if (searchInput && initQ) searchInput.value = initQ;
  if (initCat !== "all") {
    activeCategory = initCat;
    categoryButtons.forEach((b) => b.classList.toggle("active", b.dataset.category === initCat));
  }
  if (initOfficial !== "all") {
    activeOfficial = initOfficial;
    officialButtons.forEach((b) => b.classList.toggle("active", b.dataset.official === initOfficial));
  }
  if (initExhibition) {
    filterExhibition = true;
    exhibitionBtn?.classList.add("active");
  }
  if (initSort) {
    activeSort = initSort;
    sortDir = (initDir === "asc" || initDir === "desc") ? initDir : (defaultDir[initSort] ?? "asc");
    updateSortButtons();
  }
  if (initQ || initCat !== "all" || initOfficial !== "all" || initExhibition || initSort) applyFilters();
</script>
