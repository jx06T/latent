---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import { supabase } from "@/lib/supabase";
import { ProjectSchema, CATEGORIES } from "@/lib/schema";
import { z } from "zod";

// 1. 抓取 2026 年所有已發布專案
const { data, error } = await supabase
  .from("projects")
  .select("*")
  .eq("year", 2026)
  .eq("status", "published")
  .order("created_at", { ascending: false });

if (error) {
  console.error("Fetch error:", error);
}

// 2. 使用 Zod 驗證陣列資料
const projects = z.array(ProjectSchema).parse(data || []);

const THEME_COLOR = "#ff00ff"; // 2026 專屬色
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={`2026 專題列表 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style define:vars={{ theme: THEME_COLOR }}>
      main {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
        font-family: "Courier New", monospace;
      }
      .cyber-header {
        border-bottom: 2px solid var(--theme);
        margin-bottom: 3rem;
        padding-bottom: 1rem;
      }
      .cyber-header h1 {
        color: var(--theme);
        text-transform: uppercase;
        letter-spacing: 4px;
        margin: 0;
      }
      
      .project-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
        list-style: none;
        padding: 0;
      }

      .project-card {
        border: 1px solid #333;
        background: #0a0a0a;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .project-card:hover {
        border-color: var(--theme);
        box-shadow: 0 0 15px rgba(255, 0, 255, 0.2);
        transform: translateY(-5px);
      }

      .project-card a {
        text-decoration: none;
        color: inherit;
        display: block;
      }

      .cover-wrapper {
        width: 100%;
        height: 180px;
        background: #1a1a1a;
        overflow: hidden;
        border-bottom: 1px solid #333;
      }

      .cover-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.7;
        transition: 0.3s;
      }

      .project-card:hover img {
        opacity: 1;
        transform: scale(1.05);
      }

      .card-content {
        padding: 1.5rem;
      }

      .category-tag {
        font-size: 0.7rem;
        color: var(--theme);
        border: 1px solid var(--theme);
        padding: 2px 6px;
        margin-bottom: 0.5rem;
        display: inline-block;
      }

      .project-card h4 {
        margin: 0.5rem 0;
        color: #fff;
        font-size: 1.2rem;
      }

      .project-card .subtitle {
        font-size: 0.85rem;
        color: #888;
        margin-bottom: 1rem;
        height: 2.4em;
        overflow: hidden;
      }

      .card-footer {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: var(--theme);
        border-top: 1px solid #222;
        padding-top: 1rem;
      }

      @media (max-width: 720px) {
        .project-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <header class="cyber-header">
        <h1>[ 2026_PROJECT_DATABASE ]</h1>
        <p>TOTAL_RECORDS: {projects.length}</p>
      </header>

      <section>
        <ul class="project-grid">
          {projects.map((project) => (
            <li class="project-card">
              <a href={`./2026/${project.slug}`}>
                <div class="cover-wrapper">
                  <img src={project.cover_image || "https://picsum.photos/400/200?grayscale"} alt="" />
                </div>
                <div class="card-content">
                  <span class="category-tag">
                    {CATEGORIES[project.category_main]}
                  </span>
                  <h4>{project.title}</h4>
                  <p class="subtitle">{project.subtitle || "NO_SUBTITLE_PROVIDED"}</p>
                  
                  <div class="card-footer">
                    <span>BY @{project.author_handle}</span>
                    <span>ENERGY: {project.like_count}</span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>