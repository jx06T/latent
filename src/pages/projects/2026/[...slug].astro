---
export const prerender = false;

import ProseLayout from "@/layouts/ProseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Tag from "@/components/ui/Tag.astro";
import CommentLabel from "@/components/ui/CommentLabel.astro";
import Link from "@/components/ui/Link.astro";
import MarkdownContent from "@/components/ui/MarkdownContent.astro";

import { supabase } from "@/lib/supabase";
import { ProjectSchema, CATEGORIES } from "@/lib/schema";
import type { CategoryId } from "@/lib/schema";

const { slug } = Astro.params;
const CURRENT_YEAR = 2026;

if (!slug) return Astro.redirect("/404");

const cleanSlug = slug?.split("/")[0];

if (!cleanSlug || !/^[a-zA-Z0-9-]+$/.test(cleanSlug)) {
  return Astro.redirect("/404");
}

const { data: projectData, error: dbError } = await supabase
  .from("projects")
  .select("*")
  .eq("year", CURRENT_YEAR)
  .eq("slug", cleanSlug)
  .single();

if (dbError || !projectData) {
  console.error("DB Error:", dbError);
  return Astro.redirect("/404");
}

const result = ProjectSchema.safeParse(projectData);
if (!result.success) {
  console.error(
    "Zod Validation Failed:",
    JSON.stringify(result.error.format(), null, 2),
  );
  return Astro.redirect("/404");
}
const project = result.data;

const categoryLabel =
  CATEGORIES[project.category_main as CategoryId] ?? CATEGORIES[0];
const subCategoryLabels = project.category_sub
  .map((id) => CATEGORIES[id as CategoryId])
  .filter(Boolean);

const linkEntries = Object.entries(project.links).filter(([, v]) => v);
---

<ProseLayout
  title={`${project.title} · LATENT ${CURRENT_YEAR}`}
  description={project.description ??
    `${project.title} — ${categoryLabel} 專題`}
  ogImage={project.cover_image ?? undefined}
  active="projects"
>
  <!-- Breadcrumb & Categories -->
  <div
    class="flex flex-col md:flex-row justify-start items-start md:justify-between md:items-start mb-8 gap-2"
  >
    <nav
      class="font-mono text-base text-ink-dim flex items-center gap-1.5"
      aria-label="breadcrumb"
    >
      <Link href="/projects">projects</Link>
      <span>/</span>
      <span>{CURRENT_YEAR}</span>
      <span>/</span>
      <span class="text-ink">{project.slug}</span>
    </nav>

    <div class="flex flex-wrap items-center gap-2">
      <Tag variant="main">{categoryLabel}</Tag>
      <Tag variant="sub">{CURRENT_YEAR}</Tag>
      {subCategoryLabels.map((label) => <Tag variant="sub">{label}</Tag>)}
    </div>
  </div>

  <!-- Cover image -->
  {
    project.cover_image && (
      <div class="w-full h-64 sm:h-80 overflow-hidden border border-line mb-10">
        <img
          src={project.cover_image}
          alt={project.title}
          class="w-full h-full object-cover opacity-80"
        />
      </div>
    )
  }

  <!-- Header -->
  <header class="mb-8 space-y-2">
    <h1
      class="text-3xl sm:text-4xl font-black text-ink text-glow-primary leading-tight"
    >
      {project.title}
    </h1>
    {project.subtitle && <p class="text-lg text-ink-dim -mt-1.5">{project.subtitle}</p>}
    <p class="font-mono text-lg text-ink-dim -mt-1">
      by <span class="text-ink">@{project.author_handle}</span>
    </p>
  </header>

  <!-- Link buttons -->
  {
    linkEntries.length > 0 && (
      <div class="flex flex-wrap gap-3 mb-10">
        {project.links.demo && (
          <Button
            as="a"
            href={project.links.demo}
            variant="primary"
            text="線上展示"
            target="_blank"
            rel="noopener noreferrer"
          />
        )}
        {project.links.github && (
          <Button
            as="a"
            href={project.links.github}
            variant="outline"
            text="原始碼"
            target="_blank"
            rel="noopener noreferrer"
          />
        )}
        {linkEntries
          .filter(([key]) => key !== "demo" && key !== "github")
          .map(([key, url]) => (
            <Button
              as="a"
              href={url!}
              variant="secondary"
              text={key}
              target="_blank"
              rel="noopener noreferrer"
            />
          ))}
      </div>
    )
  }

  <!-- Project metadata -->
  <div class="border-dashed-cyber p-5 mb-12 space-y-5">
    <section>
      <CommentLabel text="project_overview" />
      <p class="text-base text-ink-muted leading-relaxed -mt-1">
        {project.description}
      </p>
    </section>

    {
      project.tech_stack.length > 0 && (
        <section>
          <CommentLabel text="tech_stack" />
          <div class="flex flex-wrap gap-1.5 mt-2">
            {project.tech_stack.map((tech) => (
              <Tag variant="sub">{tech}</Tag>
            ))}
          </div>
        </section>
      )
    }

    {
      project.keywords.length > 0 && (
        <section>
          <CommentLabel text="keywords" />
          <div class="flex flex-wrap gap-x-3 gap-y-1.5 -mt-1.5">
            {project.keywords.map((kw) => (
              <span class="font-mono text-base text-primary-400">
                <span class="inline-block mr-0.5">#</span>
                {kw}
              </span>
            ))}
          </div>
        </section>
      )
    }

    <div class="flex items-center gap-1 pt-4 border-t border-line">
      <span class="text-accent-500 text-base font-mono">♦ VOTES：</span>
      <span class="text-accent-500 font-mono text-xl inline-block -mt-1">
        {project.like_count}
      </span>
    </div>
  </div>

  <!-- Main article content -->
  <article class="mb-12">
    <CommentLabel text="project_details" class=" text-lg" />
    <!-- 完美套用 MarkdownContent 元件 -->
    <MarkdownContent content={project.content!} class="mt-6" />
  </article>

 、
  <!-- Footer bar -->
  <footer
    class="mt-8 pt-3 border-t border-line flex justify-between items-center"
  >
    <Link href="/projects/2026">← 返回列表</Link>
    <span class="font-mono text-xs text-ink-disabled">
      ID: {project.id.slice(0, 8)}…
    </span>
  </footer>
</ProseLayout>
