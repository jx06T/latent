---
export const prerender = false;

import BaseHead from "@/components/sections/BaseHead.astro";
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/Header.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import Button from "@/components/ui/Button.astro";
import Tag from "@/components/ui/Tag.astro";
import CommentLabel from "@/components/ui/CommentLabel.astro";
import Link from "@/components/ui/Link.astro";
import { supabase } from "@/lib/supabase";
import { ProjectSchema, CATEGORIES } from "@/lib/schema";
import type { CategoryId } from "@/lib/schema";
import { SITE_TITLE } from "@/consts";
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";

const { slug } = Astro.params;
const CURRENT_YEAR = 2026;

if (!slug) return Astro.redirect("/404");

const { data: projectData, error: dbError } = await supabase
  .from("projects")
  .select("*")
  .eq("year", CURRENT_YEAR)
  .eq("slug", slug.split("/")[0])
  .single();

if (dbError || !projectData) {
  console.error("DB Error:", dbError);
  return Astro.redirect("/404");
}

const result = ProjectSchema.safeParse(projectData);
if (!result.success) {
  console.error("❌ Zod Validation Failed:", JSON.stringify(result.error.format(), null, 2));
  return Astro.redirect("/404");
}
const project = result.data;

const rawHtml = await marked.parse(project.content || "");
const cleanHtml = sanitizeHtml(rawHtml, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(["img", "iframe"]),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    "*": ["class", "style"],
  },
});

const categoryLabel = CATEGORIES[project.category_main as CategoryId] ?? CATEGORIES[0];
const subCategoryLabels = project.category_sub
  .map((id) => CATEGORIES[id as CategoryId])
  .filter(Boolean);

const linkEntries = Object.entries(project.links).filter(([, v]) => v);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead
      title={`${project.title} · LATENT ${CURRENT_YEAR}`}
      description={project.description ?? `${project.title} — ${categoryLabel} 專題`}
      image={project.cover_image ?? undefined}
    />
  </head>
  <body class="bg-bg">
    <SmoothScroll />
    <Header active="projects" />

    <main class="pt-24 pb-32 min-h-screen">
      <div class="max-w-5xl mx-auto px-4 sm:px-6">

        <!-- Breadcrumb -->
        <nav class="font-mono text-xs text-ink-dim mb-8 flex items-center gap-1.5" aria-label="breadcrumb">
          <Link href="/projects">projects</Link>
          <span>/</span>
          <span>{CURRENT_YEAR}</span>
          <span>/</span>
          <span class="text-ink">{project.slug}</span>
        </nav>

        <!-- Cover image -->
        {project.cover_image && (
          <div class="w-full h-56 sm:h-72 overflow-hidden border border-line mb-8">
            <img
              src={project.cover_image}
              alt={project.title}
              class="w-full h-full object-cover opacity-80"
            />
          </div>
        )}

        <!-- Header -->
        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <Tag variant="main">{categoryLabel}</Tag>
            <Tag variant="sub">{CURRENT_YEAR}</Tag>
            {subCategoryLabels.map((label) => (
              <Tag variant="sub">{label}</Tag>
            ))}
          </div>

          <h1 class="text-4xl sm:text-5xl font-black text-ink text-glow-primary leading-tight">
            {project.title}
          </h1>
          {project.subtitle && (
            <p class="text-xl text-ink-dim mt-2">{project.subtitle}</p>
          )}
          <p class="text-sm text-ink-dim font-mono mt-3">
            作者：<span class="text-ink">@{project.author_handle}</span>
          </p>
        </header>

        <!-- Link buttons -->
        {linkEntries.length > 0 && (
          <div class="flex flex-wrap gap-3 mb-10">
            {project.links.demo && (
              <Button as="a" href={project.links.demo} variant="primary" text="線上展示" target="_blank" rel="noopener noreferrer" />
            )}
            {project.links.github && (
              <Button as="a" href={project.links.github} variant="outline" text="原始碼" target="_blank" rel="noopener noreferrer" />
            )}
            {linkEntries
              .filter(([key]) => key !== "demo" && key !== "github")
              .map(([key, url]) => (
                <Button as="a" href={url!} variant="secondary" text={key} target="_blank" rel="noopener noreferrer" />
              ))
            }
          </div>
        )}

        <!-- 2-col layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">

          <!-- Sidebar -->
          <aside class="lg:col-span-1 space-y-6 order-2 lg:order-1">

            <section class="border-dashed-cyber p-4">
              <CommentLabel text="project_overview" />
              <p class="text-sm text-ink-muted leading-relaxed mt-2">{project.description}</p>
            </section>

            {project.tech_stack.length > 0 && (
              <section>
                <CommentLabel text="tech_stack" />
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {project.tech_stack.map((tech) => (
                    <Tag variant="sub">{tech}</Tag>
                  ))}
                </div>
              </section>
            )}

            {project.keywords.length > 0 && (
              <section>
                <CommentLabel text="keywords" />
                <div class="flex flex-wrap gap-x-3 gap-y-1.5 mt-2">
                  {project.keywords.map((kw) => (
                    <span class="font-mono text-xs text-primary-400"># {kw}</span>
                  ))}
                </div>
              </section>
            )}

            <section class="border-solid-cyber p-3 flex items-center gap-3">
              <span class="text-accent-500 font-mono text-2xl font-black">{project.like_count}</span>
              <span class="text-ink-dim text-sm font-mono">ENERGY_VOTES</span>
            </section>

          </aside>

          <!-- Main content -->
          <article class="lg:col-span-2 order-1 lg:order-2 space-y-10">

            <section>
              <CommentLabel text="project_details" />
              <div class="prose max-w-none mt-4" set:html={cleanHtml} />
            </section>

            {project.screenshots.length > 0 && (
              <section>
                <CommentLabel text="screenshots" />
                <div class="space-y-4 mt-4">
                  {project.screenshots.map((src) => (
                    <div class="border border-line overflow-hidden">
                      <img src={src} loading="lazy" alt="" class="w-full" />
                    </div>
                  ))}
                </div>
              </section>
            )}

          </article>
        </div>

        <!-- Footer bar -->
        <footer class="mt-16 pt-6 border-t border-line flex justify-between items-center">
          <Link href="/projects/2026">← 返回列表</Link>
          <span class="font-mono text-xs text-ink-disabled">ID: {project.id.slice(0, 8)}…</span>
        </footer>

      </div>
    </main>

    <Footer />
  </body>
</html>
