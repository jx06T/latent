---
export const prerender = false;

import ProseLayout from "@/layouts/ProseLayout.astro";
import { LinkButton } from "@/components/ui/Button";
import Tag from "@/components/ui/Tag.astro";
import CommentLabel from "@/components/ui/CommentLabel";
import Link from "@/components/ui/Link";
import MarkdownContent from "@/components/ui/MarkdownContent.astro";
import LikeButton from "@/components/project/LikeButton";
import CommentsSection from "@/components/project/CommentsSection";
import ProjectCard from "@/components/modules/ProjectCard";

import { supabase } from "@/lib/supabase";
import { ProjectSchema, CATEGORIES } from "@/lib/schema";
import type { CategoryId } from "@/lib/schema";
import { replaceImageIds, extractFirstImageId } from "@/lib/markdown-image";
import { publishedUrl, type ProjectImageRow } from "@/lib/image-paths";

const { slug } = Astro.params;
const CURRENT_YEAR = 2026;

if (!slug) return Astro.redirect("/404");

const cleanSlug = slug?.split("/")[0];

if (!cleanSlug || !/^[a-zA-Z0-9-]+$/.test(cleanSlug)) {
  return Astro.redirect("/404");
}

const { data: rawData, error: dbError } = await supabase
  .from("projects")
  .select(
    `
    *,
    project_images!project_images_project_id_fkey(id, project_id, status, source_ext, published_ext, available_sizes)
  `,
  )
  .eq("year", CURRENT_YEAR)
  .eq("slug", cleanSlug)
  .single();

if (dbError || !rawData) {
  console.error("DB Error:", dbError);
  return Astro.redirect("/404");
}

// Extract images before Zod parses (Zod strips unknown keys)
const projectImages = (
  ((rawData as any).project_images ?? []) as ProjectImageRow[]
).filter((img) => img.status === "published");

const result = ProjectSchema.safeParse(rawData);
if (!result.success) {
  console.error(
    "Zod Validation Failed:",
    JSON.stringify(result.error.format(), null, 2),
  );
  return Astro.redirect("/404");
}
const project = result.data;

const resolvedContent = project.content
  ? replaceImageIds(project.content, projectImages)
  : "";

// coverImageUrl: hero image displayed on the page (only from cover_image_id)
let coverImageUrl: string | null = null;
if (project.cover_image_id) {
  const coverImg = projectImages.find(
    (img) => img.id === project.cover_image_id,
  );
  if (coverImg) {
    try {
      coverImageUrl = publishedUrl(coverImg, "md");
    } catch {}
  }
}

// ogImageUrl: OG meta tag — cover → first article image → Satori fallback
let ogImageUrl: string = new URL(
  `/og/2026/${project.slug}.jpeg`,
  Astro.url,
).toString();
if (coverImageUrl) {
  ogImageUrl = coverImageUrl;
} else if (project.content) {
  const firstId = extractFirstImageId(project.content);
  if (firstId) {
    const firstImg = projectImages.find((img) => img.id === firstId);
    if (firstImg) {
      try {
        ogImageUrl = publishedUrl(firstImg, "md");
      } catch {}
    }
  }
}

const hoursSinceUpdate =
  (Date.now() - new Date(project.updated_at ?? project.created_at).getTime()) / 36e5;
const maxAge =
  hoursSinceUpdate < 6 ? 60
  : hoursSinceUpdate < 72 ? 600
  : 3600;
Astro.response.headers.set(
  "Cache-Control",
  `public, s-maxage=${maxAge}, stale-while-revalidate=86400`,
);

const categoryLabel =
  CATEGORIES[project.category_main as CategoryId] ?? CATEGORIES[0];
const subCategoryLabels = project.category_sub
  .map((id) => CATEGORIES[id as CategoryId])
  .filter(Boolean);

const linkEntries = Object.entries(project.links).filter(([, v]) => v);

// Similar projects: pre-filter by category/author at DB level, then score in JS
const _subFilter =
  project.category_sub.length > 0
    ? `category_sub.ov.{${project.category_sub.join(",")}}`
    : null;
const _orFilter = [
  `category_main.eq.${project.category_main}`,
  _subFilter,
  `author_handle.eq.${project.author_handle}`,
]
  .filter(Boolean)
  .join(",");

const { data: candidateData } = await supabase
  .from("projects")
  .select(
    `
    id, slug, title, subtitle, author_handle, category_main, category_sub, keywords, tech_stack, cover_image_id, like_count,
    cover_image:project_images!cover_image_id(id, project_id, status, source_ext, published_ext, available_sizes)
  `,
  )
  .eq("year", CURRENT_YEAR)
  .eq("status", "published")
  .neq("id", project.id)
  .or(_orFilter)
  .limit(20);

function scoreSimilarity(candidate: any): number {
  let score = 0;
  const kwOverlap = (candidate.keywords ?? []).filter((k: string) =>
    project.keywords.includes(k),
  ).length;
  score += kwOverlap * 3;
  const techOverlap = (candidate.tech_stack ?? []).filter((t: string) =>
    project.tech_stack.includes(t),
  ).length;
  score += techOverlap * 2;
  if (candidate.category_main === project.category_main) score += 2;
  const subOverlap = (candidate.category_sub ?? []).filter((s: number) =>
    project.category_sub.includes(s),
  ).length;
  score += subOverlap;
  if (candidate.author_handle === project.author_handle) score += 2;
  return score;
}

const similarProjects = (candidateData ?? [])
  .map((p) => ({ ...p, score: scoreSimilarity(p) }))
  .filter((p) => p.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((p) => {
    let coverUrl: string | null = null;
    if (p.cover_image) {
      try {
        coverUrl = publishedUrl(
          p.cover_image as unknown as ProjectImageRow,
          "md",
        );
      } catch {}
    }
    return { ...p, coverUrl };
  });
---

<ProseLayout
  title={`${project.title} | LATENT — ${CURRENT_YEAR}`}
  description={project.description ??
    `${project.title} — ${categoryLabel} 專題`}
  ogImage={ogImageUrl}
  type="article"
  article={{
    author: project.author_handle,
    publishedTime: project.created_at,
    modifiedTime: project.updated_at ?? undefined,
    section: categoryLabel,
    tags: [...project.keywords, ...project.tech_stack],
  }}
  active="projects"
>
  <!-- Breadcrumb & Categories -->
  <div
    class="flex flex-col md:flex-row justify-start items-start md:justify-between md:items-start mb-8 gap-2"
  >
    <nav
      class="font-mono text-base text-ink-dim flex items-center gap-1.5"
      aria-label="breadcrumb"
    >
      <Link href="/projects">projects</Link>
      <span>/</span>
      <Link href={`/projects/${CURRENT_YEAR}`}>{CURRENT_YEAR}</Link>
      <span>/</span>
      <span class="text-ink">{project.slug}</span>
    </nav>

    <div class="flex flex-wrap items-center gap-2">
      <Tag variant="main">{categoryLabel}</Tag>
      <Tag variant="sub">{CURRENT_YEAR}</Tag>
      {subCategoryLabels.map((label) => <Tag variant="sub">{label}</Tag>)}
    </div>
  </div>

  <!-- Cover image -->
  {
    coverImageUrl && (
      <div class="w-full aspect-video overflow-hidden border border-line mb-10">
        <img
          src={coverImageUrl}
          alt={project.title}
          class="w-full h-full object-cover opacity-80"
        />
      </div>
    )
  }

  <!-- Header -->
  <header class="mb-8 space-y-2">
    <h1
      class="text-3xl sm:text-4xl font-black text-ink text-glow-primary leading-tight"
    >
      {project.title}
    </h1>
    {
      project.subtitle && (
        <p class="text-lg text-ink-dim -mt-1.5">{project.subtitle}</p>
      )
    }
    <p class="font-mono text-lg text-ink-dim -mt-1">
      by <a
        href={`/@${project.author_handle}`}
        class="text-ink hover:text-accent-400 transition-colors"
      >
        {project.author_handle}
      </a>
    </p>
  </header>

  <!-- Link buttons -->
  {
    linkEntries.length > 0 && (
      <div class="flex flex-wrap gap-3 mb-10">
        {project.links.demo && (
          <LinkButton
            href={project.links.demo}
            variant="primary"
            size="lg"
            bracket
            target="_blank"
            rel="noopener noreferrer"
          >
            線上展示
          </LinkButton>
        )}
        {project.links.github && (
          <LinkButton
            href={project.links.github}
            variant="outline"
            size="lg"
            bracket
            target="_blank"
            rel="noopener noreferrer"
          >
            原始碼
          </LinkButton>
        )}
        {linkEntries
          .filter(([key]) => key !== "demo" && key !== "github")
          .map(([key, url]) => (
            <LinkButton
              href={url!}
              variant="secondary"
              size="lg"
              bracket
              target="_blank"
              rel="noopener noreferrer"
            >
              {key}
            </LinkButton>
          ))}
      </div>
    )
  }

  <!-- Project metadata -->
  <div class="border-dashed-cyber p-5 mb-10 space-y-5">
    <section>
      <CommentLabel text="project_overview" />
      <p class="text-base text-ink-muted leading-relaxed -mt-1">
        {
          project.description ||
            `由 ${project.author_handle} 製作的專案 「 ${project.title} 」`
        }
      </p>
    </section>

    {
      project.tech_stack.length > 0 && (
        <section>
          <CommentLabel text="tech_stack" />
          <div class="flex flex-wrap gap-x-2 gap-y-1.5 mt-2">
            {project.tech_stack.map((tech) => (
              <Tag variant="sub">{tech}</Tag>
            ))}
          </div>
        </section>
      )
    }

    {
      project.keywords.length > 0 && (
        <section>
          <CommentLabel text="keywords" />
          <div class="flex flex-wrap gap-x-3 gap-y-1.5 -mt-1.5">
            {project.keywords.map((kw) => (
              <span class="font-mono text-base text-primary-400 mx-0.5">
                <span class="inline-block -mr-1">#</span>
                {kw}
              </span>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <!-- Like button -->
  <div class="mb-10 w-full flex justify-center">
    <LikeButton
      client:load
      projectId={project.id}
      initialCount={project.like_count ?? 0}
    />
  </div>

  <!-- Main article content -->
  <article class="mb-12">
    <CommentLabel text="project_details" className=" text-lg" />
    <!-- 完美套用 MarkdownContent 元件 -->
    <MarkdownContent content={resolvedContent} class="mt-6" />
  </article>
  <!-- Comments -->
  <CommentsSection client:load projectId={project.id} />

  <!-- Footer bar -->
  <footer class="mt-16 pt-3 border-t border-line flex items-center justify-between">
    <Link href="/projects/2026">← 返回列表</Link>
    <button
      id="share-btn"
      data-title={project.title}
      class="text-ink-dim hover:text-ink transition-colors p-1 -m-1"
      aria-label="分享此頁面"
      title="分享"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
      </svg>
    </button>
  </footer>

  <!-- Similar projects -->
  {
    similarProjects.length > 0 && (
      <section class="mt-24">
        <CommentLabel text="similar_projects" className="text-xl text-ink-dim" />
        <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-3 gap-5 mt-4">
          {similarProjects.map((p) => (
            <ProjectCard
              slug={p.slug}
              year={CURRENT_YEAR}
              title={p.title}
              subtitle={p.subtitle}
              author_handle={p.author_handle}
              category_main={p.category_main}
              cover_image={p.coverUrl}
              tech_stack={p.tech_stack ?? []}
              like_count={p.like_count ?? 0}
            />
          ))}
        </div>
      </section>
    )
  }
</ProseLayout>

<script>
  const btn = document.getElementById("share-btn");
  btn?.addEventListener("click", async () => {
    const title = (btn as HTMLButtonElement).dataset.title ?? document.title;
    const url = window.location.href;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
    } else {
      await navigator.clipboard.writeText(url);
      const prev = btn.innerHTML;
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
      setTimeout(() => { btn.innerHTML = prev; }, 1500);
    }
  });
</script>
