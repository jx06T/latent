---
export const prerender = true;

import Hero from "@/components/hero/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import EventOverview from "@/components/sections/EventOverview.astro";
import TopProjects from "@/components/sections/TopProjects.tsx";
import TelemetryDashboard from "@/components/sections/TelemetryDashboard.tsx";
import Partners from "@/components/sections/Partners.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTA from "@/components/sections/CTA.astro";
import Wavesection from "@/components/sections/Wavesection.astro";
---

<Layout
  title="Home | Latent"
  description="LATENT 2026 — 學生專題的發光基地。探索年輕創作者在 AI、硬體、互動設計等領域的作品。"
  activeNav="home"
>
  <main>
    <Hero />
    <Wavesection color="var(--color-bg-surface)" />
    <EventOverview />
    <TopProjects client:idle  />
    <TelemetryDashboard client:idle  />
    <Partners />
    <FAQ />
    <CTA />
  </main>
</Layout>
