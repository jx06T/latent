---
import ProseLayout from "@/layouts/ProseLayout.astro";
export const prerender = true;

import MarkdownContent from "@/components/ui/MarkdownContent.astro";

import copyrightContent from "@/content/copyright.md?raw";
---

<ProseLayout
  title="版權聲明與開源協議 | Latent"
  description="Latent 平台的版權相關說明，說明本網站各區塊的版權歸屬及使用者權力。"
>
  <div class="prose prose-invert max-w-none">
    <MarkdownContent content={copyrightContent} />
  </div>
</ProseLayout>
