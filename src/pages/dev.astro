---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import Tag from "@/components/ui/Tag.astro";
import ScrambleText from "@/components/ui/ScrambleText.astro";
import { House } from "lucide-react";
import CommentLabel from "@/components/ui/CommentLabel.astro";
import Input from "@/components/ui/Input.astro";
import Progress from "@/components/ui/Progress.astro";
import StatusLog from "@/components/ui/StatusLog.astro";
import LogManager from "@/components/modules/LogManager.astro";
import GoogleAuthButton from "@/components/editor/GoogleAuthButton";

// 測試用：從已存在的 projects 中取一筆 pending 專案
import { createServiceClient } from "@/lib/supabase-server";

let testProjectId = "";
try {
  const db = createServiceClient();
  const { data } = await db
    .from("projects")
    .select("id")
    .in("status", ["draft"])
    .limit(1)
    .single();
  testProjectId = data?.id ?? "";
} catch {
  // 無 service role key 時跳過
}

// 強制讓 Tailwind 編譯這些類名
const safelist = [
  "bg-bg",
  "bg-bg-surface",
  "bg-bg-elevated",
  "bg-bg-overlay",
  "bg-primary-100",
  "bg-primary-300",
  "bg-primary-500",
  "bg-primary-700",
  "bg-primary-900",
  "bg-accent-100",
  "bg-accent-300",
  "bg-accent-500",
  "bg-accent-700",
  "bg-accent-900",
  "bg-success",
  "bg-danger",
  "bg-warning",
  "bg-info",
];

const colorGroups = [
  {
    name: "Background",
    shades: ["bg", "bg-surface", "bg-elevated", "bg-overlay"],
  },
  {
    name: "Primary",
    shades: [
      "primary-100",
      "primary-300",
      "primary-500",
      "primary-700",
      "primary-900",
    ],
  },
  {
    name: "Accent",
    shades: [
      "accent-100",
      "accent-300",
      "accent-500",
      "accent-700",
      "accent-900",
    ],
  },
  { name: "Semantic", shades: ["success", "danger", "warning", "info"] },
];
---

<Layout title="DEBUG · Latent" description="系統偵錯儀表板">
  <!-- 隱藏的 div 確保類名被掃描 (另一種白嫖 Tailwind 的方式) -->
  <div class="hidden" class:list={safelist}></div>

  <main class="max-w-5xl mx-auto p-8 space-y-16">
    <header class="border-b border-line-strong pb-4">
      <h1 class="text-4xl font-black text-glow-primary">
        <ScrambleText text="系統偵錯儀表板_DEBUG" trigger="load" />
      </h1>
      <p class="text-ink-dim font-mono text-sm mt-2 uppercase">
        Status: Online | Localization: ZH-TW
      </p>
    </header>

    <section class="space-y-6">
      <h2 class="text-xl font-mono border-l-4 border-accent-500 pl-3">
        01_色樣板
      </h2>
      {
        colorGroups.map((group) => (
          <div class="space-y-2">
            <h3 class="text-xs font-mono uppercase text-ink-muted">
              {group.name}
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
              {group.shades.map((shade) => (
                <div class="space-y-1">
                  <div
                    class:list={[
                      `h-12 w-full rounded border border-line`,
                      `bg-${shade}`,
                    ]}
                  />
                  <p class="text-[10px] font-mono text-ink-dim">{shade}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <!-- 其餘組件展示保持不變... -->
    <section class="space-y-8">
      <h2 class="text-xl font-mono border-l-4 border-accent-500 pl-3">
        02_組件測試
      </h2>
      <div class="flex flex-wrap gap-4">
        <!-- 方式 A: 用 Prop 傳遞文字，自動 Scramble -->
        <Button text="ENTER_SYSTEM" scramble class="text-xl" />

        <!-- 方式 B: 用 Slot 輸入自定義 HTML (例如加個 Icon) -->
        <Button variant="outline">
          <House className=" inline size-4" />
          <span>PROFILE</span>
        </Button>
        <!-- 方式 A: 一般內部連結 -->
        <Link href="/about" text="了解更多" />

        <!-- 方式 B: 外部連結 帶 Icon-->
        <Link href="https://github.com" isExternal showIcon text="查看原始碼" />

        <!-- 方式 C: 讓 Link 也能 Scramble -->
        <Link href="/projects" text="瀏覽所有專案" scramble />
        <div>
          <Tag variant="main">人工智慧</Tag>
          <Tag variant="sub">TypeScript</Tag>
        </div>
      </div>
    </section>

    <section class="bg-bg p-8 max-w-2xl border border-line">
      <!-- 搜尋框範例 -->
      <div class="mb-8">
        <CommentLabel text="query_database" />
        <Input
          id="search"
          placeholder="search projects, authors, keywords..."
        />
      </div>

      <!-- 留言板範例 -->
      <div class="mb-4">
        <CommentLabel text="broadcast_message" />
        <Input
          type="textarea"
          placeholder="leave a message · @mention or #tag..."
          rows={4}
        />
      </div>

      <!-- 送出按鈕 -->
      <div class="flex justify-end">
        <Button variant="primary" text="EXECUTE_SEND" class="text-sm" />
      </div>
    </section>

    <section>
      <div class="max-w-md space-y-8 p-10">
        <Progress label="SYSTEM_STABILITY" value={92} />
        <Progress label="CORE_TEMPERATURE" value={45} />
        <Progress label="READINESS" value={67} />
      </div>
    </section>
    <section>
      <div class="flex flex-col gap-2">
        <StatusLog type="success" message="vote registered · +1 energy" />
        <StatusLog type="warning" message="moderation pending · review" />
        <StatusLog type="error" message="no match found · query timeout" />
      </div>
      <LogManager/>
      <Button id="like-btn" text="LIKE_PROJECT" class=" mt-2"/>

      <script>
        const testBtn = document.getElementById("like-btn");

        testBtn?.addEventListener("click", () => {
          if (typeof window.notify === "function") {
            window.notify("數據封包同步成功", "success");
          } else {
            console.error("Critical: window.notify is not defined yet.");
          }
        });
      </script>
    </section>

    <!-- 08+09 圖片編輯器 & 發布流程測試 → 已遷移至 /profile 和 /editor/[id] -->
    <section class="space-y-4">
      <h2 class="text-xl font-mono border-l-4 border-accent-500 pl-3">
        08_Auth 狀態
      </h2>
      <div class="flex items-center gap-4">
        <span class="text-[10px] font-mono uppercase text-ink-muted">AUTH_STATUS</span>
        <GoogleAuthButton client:only="react" />
      </div>
      <p class="text-xs font-mono text-ink-muted">
        編輯器與發布流程請至 <a href="/profile" class="text-accent-500 hover:underline">/profile</a> 操作。
        {testProjectId && (
          <span> 快速連結：<a href={`/editor/${testProjectId}`} class="text-accent-500 hover:underline">/editor/{testProjectId}</a></span>
        )}
      </p>
    </section>

  </main>
</Layout>
