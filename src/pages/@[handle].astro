---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/modules/ProjectCard";
import { createAnonClient } from "@/lib/supabase-server";
import { publishedUrl, toCdnUrl, draftKey } from "@/lib/image-paths";
import { getAvatarUrl } from "@/lib/avatar";
import CommentLabel from "@/components/ui/CommentLabel";

const { handle } = Astro.params;

const db = createAnonClient();

// Fetch public profile
const { data: profile } = await db
  .from("profiles")
  .select("id, handle, nickname, bio, tags, avatar_url, created_at")
  .eq("handle", handle!)
  .maybeSingle();

if (!profile) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

// Fetch published projects with cover image data
const { data: projects } = await db
  .from("projects")
  .select(
    `
    id, title, slug, year, subtitle, description, category_main, cover_image_id, keywords, tech_stack, like_count,
    cover_image:project_images!projects_cover_image_id_fkey(id, project_id, status, published_ext, available_sizes, source_ext)
  `,
  )
  .eq("author_id", profile.id)
  .eq("status", "published")
  .order("created_at", { ascending: false });

function getCoverUrl(p: any): string | null {
  const img = p.cover_image;
  if (!img) return null;
  try {
    if (
      img.status === "published" &&
      img.published_ext &&
      img.available_sizes?.length
    ) {
      return publishedUrl(img, "md");
    }
    if (img.status === "draft" && img.source_ext) {
      return toCdnUrl(draftKey(img.project_id, img.id, img.source_ext));
    }
  } catch {
    /* ignore */
  }
  return null;
}

const avatarUrl = getAvatarUrl(profile.avatar_url ?? handle);
const joinYear = new Date(profile.created_at).getFullYear();

function parseBio(text: string) {
  return text.split(/(https?:\/\/[^\s]+)/g).map((part) => ({
    isUrl: part.startsWith("http://") || part.startsWith("https://"),
    text: part,
  }));
}
---

<Layout
  title={`${profile.nickname} (@${profile.handle}) | Latent`}
  description={profile.bio || `${profile.nickname} 在 Latent 的個人頁面`}
>
  <main class="max-w-5xl mx-auto px-4 xs:px-6 sm:px-10 pt-24 pb-24 font-mono">
    {/* ── Profile Header ───────────────────────────────────────── */}
    <section class="flex flex-col sm:flex-row gap-6 sm:gap-8 mb-3 items-start">
      <img
        src={avatarUrl}
        alt={`${profile.nickname} 的頭像`}
        width="96"
        height="96"
        class="w-24 h-24 border border-line bg-bg-elevated shrink-0"
      />
      <div class="space-y-2 min-w-0">
        <div class="flex flex-wrap items-baseline gap-3">
          <h1 class="text-xl text-ink">{profile.nickname}</h1>
          <span class="text-sm text-ink-dim">@{profile.handle}</span>
        </div>
        {
          profile.tags?.map((tag) => (
            <span class="inline-block border border-primary-700 bg-primary-950 mr-2 text-ink-dim text-sm px-2 py-0.5">
              {tag}
            </span>
          ))
        }
        <p class="text-sm text-ink-ddim">加入於 {joinYear} 年</p>
      </div>
    </section>
    <section class="mb-16 max-h-60 overflow-y-auto">
      {
        profile.bio ? (
          <p class="text-sm text-ink-muted whitespace-pre-wrap wrap-break-word">{
            parseBio(profile.bio).map((part) =>part.isUrl ? (
                <a
                  href={part.text}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary-400 underline underline-offset-2 hover:text-primary-300"
                >{part.text}</a>
              ) : (
                part.text
              ),
            )}</p>
        ) : null
      }
    </section>

    {/* ── Projects ─────────────────────────────────────────────── */}
    <div class="flex items-end justify-between mb-6">
      <h2 class="text-sm uppercase tracking-widest text-ink-muted">作品</h2>
      <span class="text-sm text-ink-ddim">{projects?.length ?? 0} 件</span>
    </div>
    <section class="max-w-6xl mx-auto">
      {
        !projects || projects.length === 0 ? (
          <div class="flex flex-col items-center justify-center py-24 text-center border-dashed-cyber">
            <CommentLabel text="no_records_found" />
            <p class="font-mono text-ink-dim mt-4">// 目前尚無已發佈的專題</p>
          </div>
        ) : (
          <ul
            id="project-grid"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"
          >
            {projects.map((project) => (
              <li
                data-title={project.title.toLowerCase()}
                data-category={project.category_main}
                data-keywords={(project.keywords ?? []).join(" ").toLowerCase()}
              >
                <ProjectCard
                  slug={project.slug}
                  year={project.year ?? 0}
                  title={project.title}
                  subtitle={project.subtitle}
                  author_handle={handle!}
                  category_main={project.category_main}
                  cover_image={getCoverUrl(project)}
                  tech_stack={(project.tech_stack as string[] | null) ?? []}
                  like_count={project.like_count ?? 0}
                />
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Layout>
