---
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/ui/Link";
---

<Layout title="500 — 伺服器錯誤" description="伺服器發生了一些問題，請稍後再試。">
  <main
    class="flex-1 flex flex-col items-center justify-center gap-8 px-6 py-24 font-mono w-full h-[70vh]"
  >
    <div class="text-center space-y-3 text-6xl">
      <p class="font-bold text-accent-500 leading-none">500</p>
      <p class="text-ink-dim text-base tracking-widest uppercase">伺服器或網路錯誤</p>
      <p class="text-ink-ddim text-sm tracking-wide normal-case">您可以嘗試重新整理頁面，或稍後再試。</p>
      <p class="text-ink-ddim text-sm tracking-wide normal-case">您也可以透過 <Link href="/contact">Contact</Link> 聯繫我們。</p>

    </div>

    <div class="flex flex-wrap gap-3 justify-center">
      <button
        onclick="window.location.reload()"
        class="inline-flex items-center justify-center gap-1.5 border px-3.5 py-2 text-sm tracking-widest uppercase font-mono transition-colors duration-150 text-ink-muted border-line hover:border-line-active hover:text-ink cursor-pointer"
      >
        重新整理
      </button>
      <a
        href="/projects"
        class="inline-flex items-center justify-center gap-1.5 border px-3.5 py-2 text-sm tracking-widest uppercase font-mono transition-colors duration-150 text-ink-muted border-line hover:border-line-active hover:text-ink"
      >
        回到專案頁
      </a>
    </div>
  </main>
</Layout>
