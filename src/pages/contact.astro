---
export const prerender = true;

import ProseLayout from "@/layouts/ProseLayout.astro";
import ContactForm from "@/components/contact/ContactForm";
---

<ProseLayout
  title="聯絡我們 | Latent"
  description="有任何問題、合作意向或想提交你的專題？歡迎透過表單與我們聯繫。"
>
  <div class="space-y-8 pt-6">
    <div class="prose max-w-none">
      <h1>聯絡我們</h1>
      <p class="lead">
        有任何問題、合作意向，或是想一起讓這個網站更好？
        填寫以下表單，我們將盡快回覆。
      </p>
    </div>

    <ContactForm client:load />

    <div class="prose max-w-none border-t border-line pt-6 mt-6">
      <p class="text-sm text-ink-dim">
        您也可以直接在
        <a href="https://github.com/jx06T/latent" target="_blank" rel="noopener noreferrer">GitHub</a>
        上建立一個 issue，或嘗試透過各專題頁面中的作者資訊直接聯繫。
      </p>
    </div>
  </div>
</ProseLayout>
