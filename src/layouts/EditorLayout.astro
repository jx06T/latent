---
import BaseHead from "@/components/sections/BaseHead.astro"
import "@/styles/global.css"
import GISInit from "@/components/ui/GISInit"

interface Props {
  title: string
  description?: string
  bodyClass?: string
}

const { title, description = title, bodyClass = 'bg-bg text-ink' } = Astro.props
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline src="https://accounts.google.com/gsi/client" async></script>
  </head>
  <body class={bodyClass}>
    <slot />
    <GISInit client:only="react" />
  </body>
</html>
