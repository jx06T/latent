---
// src/layouts/BaseLayout.astro
import "@/styles/global.css"; // 確保全域 CSS 引入
import BaseHead from "@/components/sections/BaseHead.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import LogManager from "@/components/modules/LogManager.astro";
import LoginModal from "@/components/ui/LoginModal";
import GISInit from "@/components/ui/GISInit";
import { cn } from "@/lib/utils";

import type { ArticleMeta } from "@/lib/og-types";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  article?: ArticleMeta;
  activeNav?: "home" | "about" | "projects" | "profile";
  bodyClass?: string;
  withAuth?: boolean;
}

const {
  title,
  description,
  image,
  type,
  article,
  activeNav,
  bodyClass = "",
  withAuth = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      article={article}
    />
    <!-- Google Identity Services SDK — required for GIS-based auth (no Supabase domain in URL) -->
    <script is:inline src="https://accounts.google.com/gsi/client" async
    ></script>
  </head>
  <body class={cn("", bodyClass)}>
    <SmoothScroll />
    <Header active={activeNav} />
    <slot />
    <Footer />
    <LogManager />
    <!-- Global login modal: listens for latent:show-login-modal events from any island -->
    <LoginModal client:only="react" />
    <!-- GIS SDK init: enables promptOneTap + GISButton rendering on auth-required pages -->
    {withAuth && <GISInit client:only="react" />}
  </body>
</html>
