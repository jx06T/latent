---
// src/layouts/BaseLayout.astro
import "@/styles/global.css"; // 確保全域 CSS 引入
import BaseHead from "@/components/sections/BaseHead.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import { cn } from "@/lib/utils";

interface Props {
  title: string;
  description: string;
  image?: string;
  activeNav?: "home" | "about" | "projects" | "profile";
  bodyClass?: string;
}

const { title, description, image, activeNav, bodyClass = "" } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class={cn("", bodyClass)}>
    <SmoothScroll />
    <Header active={activeNav} />
    <slot />

    <Footer />
  </body>
</html>
