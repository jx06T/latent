---
// src/layouts/BaseLayout.astro
import "@/styles/global.css"; // 確保全域 CSS 引入
import BaseHead from "@/components/sections/BaseHead.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import LogManager from "@/components/modules/LogManager.astro";
import { cn } from "@/lib/utils";

import type { ArticleMeta } from "@/lib/og-types";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  article?: ArticleMeta;
  activeNav?: "home" | "about" | "projects" | "profile";
  bodyClass?: string;
}

const { title, description, image, type, article, activeNav, bodyClass = "" } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} article={article} />
  </head>
  <body class={cn("", bodyClass)}>
    <SmoothScroll />
    <Header active={activeNav} />
    <slot />
    <Footer />
    <LogManager />
  </body>
</html>
