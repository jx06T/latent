---
// src/layouts/ProseLayout.astro
import BaseLayout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  active?: "home" | "about" | "projects" | "profile";
}

const { title, description, ogImage, active } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  activeNav={active}
>
  <main class="pt-24 pb-32 min-h-screen">
    <article class="mx-auto w-full max-w-3xl px-4 sm:px-8">
      <slot />
    </article>
  </main>
</BaseLayout>
