---
import BaseLayout from "./Layout.astro";
import type { ArticleMeta } from "@/lib/og-types";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
  article?: ArticleMeta;
  active?: "home" | "about" | "projects" | "profile";
  withAuth?: boolean;
}

const { title, description, ogImage, type, article, active, withAuth } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  type={type}
  article={article}
  activeNav={active}
  withAuth={withAuth}
>
  <main class="pt-24 pb-32 min-h-screen">
    <article class="mx-auto w-full max-w-3xl px-7 sm:px-10 pt-4 ">
      <slot />
    </article>
  </main>
</BaseLayout>
