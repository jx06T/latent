---
import { Image } from 'astro:assets'
import bgPixels from '@/assets/bg-pixels.png'
---

<!--
  bg-pixels 被 DetectionOverlay 的 <clipPath id="pixel-clip"> 遮罩
  只在橘色偵測框內可見，產生「掃描」效果
  clip-path 由 parallax.ts initPixelMask() 動態套用
-->
<div class="bg-pixels" data-parallax-layer="pixels">
  <Image
    src={bgPixels}
    alt=""
    aria-hidden="true"
    class="bg-pixels__img"
    loading="eager"
    decoding="sync"
    quality={95}
  />
</div>

<style>
  .bg-pixels {
    position: absolute;
    inset: 0;
    z-index: 2;
    will-change: transform;
    /*
      clip-path 在 parallax.ts 裡動態設定為 url(#pixel-clip)
      等 DetectionOverlay SVG 掛載後才能引用
    */
  }

  .bg-pixels__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;

    /* 關鍵：阻止瀏覽器平滑插值，保留像素感 */
    image-rendering: pixelated;
    image-rendering: crisp-edges; /* Firefox fallback */
  }
</style>