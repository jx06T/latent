---
import { Image } from 'astro:assets'
import bgLines from '@/assets/bg-lines.png'
---

<div class="bg-lines" data-parallax-layer="lines">
  <Image
    src={bgLines}
    alt=""
    aria-hidden="true"
    class="bg-lines__img"
    loading="eager"
    decoding="sync"
    quality={90}
  />
</div>

<style>
  .bg-lines {
    position: absolute;
    inset: 0;
    z-index: 1;
    will-change: transform;
  }

  .bg-lines__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
</style>