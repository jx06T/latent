---
import Tag from "@/components/ui/Tag.astro";
import { CATEGORIES } from "@/lib/schema";
import type { CategoryId } from "@/lib/schema";
import CommentLabel from "@/components/ui/CommentLabel";
import { ArrowUpRight } from "lucide-react";
import Link from "@/components/ui/Link.astro";

interface Props {
  slug: string;
  year: number;
  title: string;
  subtitle?: string | null;
  author_handle: string;
  category_main: number;
  cover_image?: string | null;
  tech_stack: string[];
  like_count: number;
}

const {
  slug,
  year,
  title,
  subtitle,
  author_handle,
  category_main,
  cover_image,
  tech_stack,
  like_count,
} = Astro.props;

const categoryLabel = CATEGORIES[category_main as CategoryId] ?? CATEGORIES[0];
---

<article
  class="group flex flex-col bg-bg-surface border border-line hover:border-line-active
         transition-colors duration-300 hover:shadow-primary-sm relative"
>
  <!-- Cover image -->
  <div
    class="w-full aspect-video bg-bg-elevated overflow-hidden border-b border-line block"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      cover_image ? (
        <img
          loading="lazy"
          src={cover_image}
          alt=""
          class="w-full h-full object-cover opacity-70 group-hover:opacity-100
               group-hover:scale-105 transition-all duration-500"
        />
      ) : (
        <div class="w-full h-full p-[10%] group-hover:scale-105 transition-all duration-500">
          <div class="w-full h-full  border-dashed-cyber  flex items-center justify-center ">
            <span class="  text-center  font-mono text-xs text-ink-ddim ">
              // NO_COVER_SIGNAL
            </span>
          </div>
        </div>
      )
    }
  </div>

  <!-- Card body -->
  <div class="p-2 w-full pt-1">
    <div class="flex flex-col flex-1 p-2">
      <a href={`/projects/${year}/${slug}`} class="cursor-pointer">
        <span class="text-ink text-xl hover:text-accent-500">
          {title}
          <ArrowUpRight className=" font-bold inline-block -ml-1.75" />
        </span>
      </a>
      <CommentLabel text={subtitle ?? "NO_SUBTITLE"} />

      <div class="flex flex-wrap gap-1.5 mt-2">
        {
          tech_stack.slice(0, 3).map((t) => (
            <Tag variant="sub" class=" text-xs ">
              {t}
            </Tag>
          ))
        }
        {
          tech_stack.length > 3 && (
            <Tag variant="sub" class=" text-xs ">
              +{tech_stack.length - 3}
            </Tag>
          )
        }
      </div>
    </div>
    <Tag class="text-sm w-full mt-3">
      <span class="text-[10px] inline-block mr-1">■</span>{categoryLabel}</Tag
    >
  </div>

  <!-- Card footer -->
  <footer
    class="flex justify-between items-center px-4 py-2.5 border-t border-line
           font-mono text-xs text-ink-dim"
  >
    <Link
      href={`/@${author_handle}`}
      class="text-ink-dim"
      text={`@${author_handle}`}
    />
    <span class="text-accent-500">♦ {like_count}</span>
  </footer>

  <span
    class="absolute -top-0.5 -right-0.5 w-4 h-4 border-t-2 border-r-2 border-accent-500
           opacity-0 group-hover:opacity-100 transition-opacity duration-700"
    aria-hidden="true"></span>
  <span
    class="absolute -bottom-0.5 -left-0.5 w-4 h-4 border-b-2 border-l-2 border-accent-500
           opacity-0 group-hover:opacity-100 transition-opacity duration-700"
    aria-hidden="true"></span>
</article>
