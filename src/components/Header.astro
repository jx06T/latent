            />
          );
        })()
      }
    </svg> -->
  </div>
</header>

<style is:global>
  @keyframes sb-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }
</style>

<script>
  // Animated views counter — eases from (views - 124) up to views once on mount.
  // Uses requestAnimationFrame; respects prefers-reduced-motion.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>(".statusbar").forEach((bar) => {
    const counter = bar.querySelector<HTMLElement>("[data-views-counter]");
    const target = Number(bar.dataset.views || "0");
    if (!counter || !target) return;
    if (reduce) {
      counter.textContent = target.toLocaleString();
      return;
    }
    const from = target - 124;
    const dur = 1400;
    const start = performance.now();
    const tick = (t: number) => {
      const k = Math.min(1, (t - start) / dur);
      const eased = 1 - Math.pow(1 - k, 3);
      const v = Math.round(from + (target - from) * eased);
      counter.textContent = v.toLocaleString();
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
