---
import CommentLabel from "@/components/ui/CommentLabel";
import ScrambleText from "@/components/ui/ScrambleText";
import LatentLogo from "@/components/ui/LatentLogo.astro";
---

<div class="panel-inner h-full xs:w-md w-screen px-8">
  <CommentLabel text="event_info" />

  <h2 class="mt-3 leading-tight w-full">
    <LatentLogo class="w-32 md:w-36 xl:w-40 block" />
  </h2>
  <h3 class="mt-1 text-base md:text-lg lg:text-xl text-accent-500">
    <ScrambleText text="2026 建北電資聯合社展" client:visible />
  </h3>
  <div class="mt-8 space-y-4 font-mono text-base">
    <div class="flex gap-1 items-start">
      <span class="text-ink-dim shrink-0 w-11">DATE</span>
      <span class="text-ink">2026 / 05 / 31 (SUN)</span>
    </div>
    <div class="flex gap-1 items-start">
      <span class="text-ink-dim shrink-0 w-11">TIME</span>
      <span class="text-ink">10:30 — 18:00</span>
    </div>
    <div class="flex gap-1 items-start">
      <span class="text-ink-dim shrink-0 w-11">VENUE</span>
      <div>
        <p class="text-ink">建國中學 夢紅樓藝廊</p>
        <p class="text-ink-dim text-sm mt-0.5">台北市中正區南海路 56 號</p>
      </div>
    </div>
  </div>

  <div class="mt-8 border-t-2 border-line pt-6 space-y-2 font-mono text-sm">
    <div class="flex gap-2 items-center">
      <span class="text-accent-500">✦</span>
      <span class="text-ink-dim">主辦</span>
      <span class="text-ink"
        >建中電子計算機研習社<span class="inline-block mx-1 mb-1">×</span
        >北一資訊研習社</span
      >
    </div>
    <div class="flex gap-2 items-center">
      <span class="text-line-active">✦</span>
      <span class="text-ink-dim">協辦</span>
      <span class="text-ink-muted"
        >建中資訊、成功電研、中山資研、景美電資</span
      >
    </div>
    <div class="flex gap-2 items-center">
      <span class="text-line-active">✦</span>
      <span class="text-ink-dim">指導單位</span>
      <span class="text-ink-muted"
        >臺北市政府青年局</span
      >
    </div>
  </div>

  <p class="mt-8 text-sm text-ink-muted leading-relaxed max-w-sm">
    LATENT，意為「潛而未顯」
    <br />
    在尚未被看見之前，創作早已悄然生長。每一年，來自不同資訊社團的學生在這裡展出作品，
    讓這些未顯的創意，逐漸浮現於眾人眼前。
  </p>
</div>
