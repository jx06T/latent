---
import CommentLabel from "@/components/ui/CommentLabel";

const TIMELINE = [
  { time: "10:30", label: "報到、開幕式 & 長官致詞", note: "Registration, Opening Ceremony" },
  { time: "11:00", label: "專題講座：AI 時代的攝影", note: "Keynote: AI × Photography", accent: true },
  { time: "12:00", label: "午餐 & 休息", note: "Lunch Break" },
  { time: "13:10", label: "專案展覽", note: "Project Exhibition", accent: true },
  { time: "15:10", label: "互動體驗", note: "Interactive Experience", accent: true },
  { time: "16:50", label: "頒獎典禮 & 閉幕", note: "Award Ceremony & Closing"},
];
---

<div class="panel-inner h-full xs:w-88  w-screen px-8 ">
  <CommentLabel text="event_timeline" />
  <h3 class="text-2xl font-black text-ink mt-2 mb-4">活動時程</h3>

  <!-- Vertical track line -->
  <div class="relative">
    <div class="absolute left-1.75 top-1 h-full w-0.5 bg-line"></div>

    <div class=" -left-6.75">
      {TIMELINE.map((item, i) => (
        <div class="relative flex gap-5 pb-4 last:pb-0">
          <!-- Node -->
          <div class={`w-13 shrink-0 flex flex-col items-start pt-0.5 z-10`}>
            <div class={`w-4 h-4 rounded-full border-2 flex items-center justify-center bg-bg
              ${item.accent ? "border-accent-500" : "border-line-active"}`}>
              <div class={`w-1.5 h-1.5 rounded-full ${item.accent ? "bg-accent-500" : "bg-primary-500"}`}></div>
            </div>
          </div>

          <!-- Content -->
          <div class="-mt-0.5 pb-1">
            <div class="font-mono text-sm text-ink-dim mb-0">{item.time}</div>
            <div class={` text-base text-ink`}>
              {item.label}
            </div>
            <div class="font-mono text-sm text-ink-ddim -mt-1">{item.note}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
