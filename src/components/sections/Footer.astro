---
import WaveSection from "./Wavesection.astro";
import Link from "../ui/Link.astro";
import LatentLogo from "@/components/ui/LatentLogo.astro";
import LatentIcon from "../ui/LatentIcon.astro";
---

<WaveSection position="top" class="mt-24">
  <footer
    class="flex flex-col justify-top pt-4 pb-4 items-center w-full gap-y-4"
  >
    <LatentLogo class="text-accent-500 w-36" />

    <nav class="space-x-5" aria-label="Footer navigation">
      <Link href="/privacy" underLine={false}>Privacy</Link>
      <Link href="/about" underLine={false}>About</Link>
      <Link href="/contact" underLine={false}>Contact</Link>
    </nav>

    <div class="text-center space-y-0">
      <p class="text-primary-400 text-sm">
        © {new Date().getFullYear()} latent. All rights reserved.
      </p>
      <p class="text-ink-ddim text-sm font-mono uppercase tracking-widest">
        Crafted by
        <Link
          href="https://github.com/jx06t"
          isExternal
          underLine={false}
          class="text-ink-dim hover:text-accent-400 p-0 m-0">jx06t</Link
        >
        | Jointly owned by
        <Link
          href="https://www.ckefgisc.org/"
          isExternal
          underLine={false}
          class="text-ink-dim hover:text-accent-400 p-0 m-0"
        >
          CKEFGISC
        </Link>
      </p>
    </div>

    <div
      class="w-full flex justify-between px-2 md:px-[5%] text-xs mt-2 text-black leading-3 md:leading-4"
    >
      <div class="bg-gray-600 w-fit py-0.5 px-1">
        <pre>Latent [adj.]
present bot not yet visible or active</pre>
      </div>
      <div class="w-8 md:w-12">
        <LatentIcon class="h-full text-gray-600" />
      </div>
    </div>
  </footer>
</WaveSection>
