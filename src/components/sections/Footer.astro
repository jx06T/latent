---
import WaveSection from "./Wavesection.astro";
import Link from "../ui/Link.astro";
import LatentLogo from "@/components/ui/LatentLogo.astro";
---

<WaveSection position="top" class="mt-24">
  <footer
    class="flex flex-col justify-top pt-4 pb-14 items-center w-full gap-y-4"
  >
    <LatentLogo class="text-accent-500 w-36" />

    <nav class="space-x-5" aria-label="Footer navigation">
      <Link href="/privacy" underLine={false}>Privacy</Link>
      <Link href="/about" underLine={false}>About</Link>
      <Link href="/contact" underLine={false}>Contact</Link>
    </nav>

    <p class="text-primary-400 text-xs">
      © {new Date().getFullYear()} latent. All rights reserved.
    </p>
  </footer>
</WaveSection>
