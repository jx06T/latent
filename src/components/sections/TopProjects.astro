---
import CommentLabel from "@/components/ui/CommentLabel.astro";
import ProjectCard from "@/components/modules/ProjectCard.astro";
import Button from "@/components/ui/Button.astro";

interface ProjectCardProps {
  slug: string;
  year: number;
  title: string;
  subtitle?: string;
  author_handle: string;
  category_main: number;
  cover_image?: string | null;
  tech_stack: string[];
  like_count: number;
}

interface Props {
  projects?: ProjectCardProps[];
}

const MOCK_PROJECTS: ProjectCardProps[] = [
  {
    slug: "neural-canvas",
    year: 2026,
    title: "Neural Canvas",
    subtitle: "以 GAN 生成藝術風格的互動畫布",
    author_handle: "ai_artist",
    category_main: 1,
    cover_image: null,
    tech_stack: ["Python", "PyTorch", "React"],
    like_count: 42,
  },
  {
    slug: "data-observatory",
    year: 2026,
    title: "Data Observatory",
    subtitle: "即時視覺化全球氣候變遷數據儀表板",
    author_handle: "viztech",
    category_main: 4,
    cover_image: null,
    tech_stack: ["D3.js", "Svelte", "PostgreSQL"],
    like_count: 38,
  },
  {
    slug: "circuit-breaker",
    year: 2026,
    title: "Circuit Breaker",
    subtitle: "融合音樂與電路設計的互動音效裝置",
    author_handle: "hw_hacker",
    category_main: 6,
    cover_image: null,
    tech_stack: ["Arduino", "C++", "Web Audio API"],
    like_count: 31,
  },
];

const { projects = MOCK_PROJECTS } = Astro.props;
---

<section id="top-projects" class="py-24 overflow-hidden bg-bg border-t border-line">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <div class="mb-16 text-center">
      <CommentLabel text="top_projects_2026" />
      <h2 class="text-3xl sm:text-4xl font-black text-ink text-glow-primary mt-2">
        [ TOP_PROJECTS ]
      </h2>
      <p class="text-ink-dim font-mono text-sm mt-2">// 本屆最受矚目的三件專題</p>
    </div>

    <!-- Cards container: fixed height for absolute positioning -->
    <div
      id="cards-container"
      class="relative flex justify-center items-center"
      style="height: 480px;"
    >
      {projects.map((project, i) => (
        <div
          class="card-wrapper absolute"
          data-index={i}
          style={`z-index: ${[1, 3, 2][i]};`}
        >
          <div style="width: 320px;">
            <ProjectCard {...project} />
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <Button as="a" href="/projects/2026" variant="outline" text="VIEW_ALL_PROJECTS" />
    </div>
  </div>
</section>

<style>
  .card-wrapper {
    transform-origin: center bottom;
    will-change: transform;
  }
  @keyframes glitch-shift {
    0%, 100% {
      transform: translate(0) rotate(var(--card-rotation, 0deg));
      filter: none;
    }
    20% {
      transform: translate(-3px, 1px) rotate(var(--card-rotation, 0deg));
      filter: hue-rotate(15deg) brightness(1.1);
    }
    60% {
      transform: translate(3px, -1px) rotate(var(--card-rotation, 0deg));
      filter: hue-rotate(-15deg);
    }
  }
  .card-wrapper:hover {
    animation: glitch-shift 0.2s steps(2, start) 1;
    cursor: pointer;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("top-projects");
    if (!section) return;

    const ctx = gsap.context(() => {
      const cards = section.querySelectorAll<HTMLElement>(".card-wrapper");
      if (cards.length < 3) return;

      const getSpread = () => Math.min(window.innerWidth * 0.28, 340);

      // Initial stacked state with slight rotation to suggest a deck
      gsap.set(cards[0], { x: 0, xPercent: -50, yPercent: -50, rotation: -4, zIndex: 1 });
      gsap.set(cards[1], { x: 0, xPercent: -50, yPercent: -50, rotation: 0, zIndex: 3 });
      gsap.set(cards[2], { x: 0, xPercent: -50, yPercent: -50, rotation: 4, zIndex: 2 });

      const finalRotations = [-8, 0, 8];

      cards.forEach((card, i) => {
        gsap.to(card, {
          x: () => (i - 1) * getSpread(),
          rotation: finalRotations[i],
          ease: "power2.out",
          scrollTrigger: {
            trigger: section,
            start: "top 65%",
            end: "center center",
            scrub: 1.2,
            invalidateOnRefresh: true,
          },
        });

        // Store final rotation for glitch CSS variable
        card.style.setProperty("--card-rotation", `${finalRotations[i]}deg`);
      });
    }, section);

    document.addEventListener("astro:before-swap", () => ctx.revert(), {
      once: true,
    });
  });
</script>
