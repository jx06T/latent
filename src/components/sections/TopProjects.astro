---
import CommentLabel from "@/components/ui/CommentLabel.astro";
import ProjectCard from "@/components/modules/ProjectCard.astro";
import Button from "@/components/ui/Button.astro";
import ScrambleText from "../ui/ScrambleText.astro";

interface ProjectCardProps {
  slug: string;
  year: number;
  title: string;
  subtitle?: string;
  author_handle: string;
  category_main: number;
  cover_image?: string | null;
  tech_stack: string[];
  like_count: number;
}

interface Props {
  projects?: ProjectCardProps[];
}

const MOCK_PROJECTS: ProjectCardProps[] = [
  {
    slug: "neural-canvas",
    year: 2026,
    title: "Neural Canvas",
    subtitle: "以 GAN 生成藝術風格的互動畫布",
    author_handle: "ai_artist",
    category_main: 1,
    cover_image: null,
    tech_stack: ["Python", "PyTorch", "React"],
    like_count: 42,
  },
  {
    slug: "data-observatory",
    year: 2026,
    title: "Data Observatory",
    subtitle: "即時視覺化全球氣候變遷數據儀表板",
    author_handle: "viztech",
    category_main: 4,
    cover_image: null,
    tech_stack: ["D3.js", "Svelte", "PostgreSQL"],
    like_count: 38,
  },
  {
    slug: "circuit-breaker",
    year: 2026,
    title: "Circuit Breaker",
    subtitle: "融合音樂與電路設計的互動音效裝置",
    author_handle: "hw_hacker",
    category_main: 6,
    cover_image: null,
    tech_stack: ["Arduino", "C++", "Web Audio API"],
    like_count: 31,
  },
];

const { projects = MOCK_PROJECTS } = Astro.props;
---

<section
  id="top-projects"
  class="py-24 overflow-hidden bg-bg border-t border-line"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="mb-4 text-center">
      <h2
        class="text-3xl sm:text-4xl font-black text-ink text-glow-primary mt-2"
      >
        <ScrambleText text="[ TOP_PROJECTS ]" />
      </h2>

      <CommentLabel text="本屆最受矚目的三件專題" />
    </div>

    <div id="cards-container" class="relative w-full h-[580px] md:h-[480px]">
      {
        projects.map((project, i) => (
          <div
            class="hover-top card-gsap-controller absolute left-1/2 top-1/2 will-change-transform"
            data-index={i}
            style={`z-index: ${[1, 3, 2][i]};`}
          >
            <div class="card-hover-target relative w-70 sm:w-[320px] group transition-z duration-200 hover:z-50 cursor-pointer">
              <ProjectCard {...project} />
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-12">
      <Button
        as="a"
        href="/projects/2026"
        variant="outline"
        text="VIEW_ALL_PROJECTS"
      />
    </div>
  </div>
</section>

<style>
  @keyframes glitch-shift {
    0%,
    100% {
      transform: translate(0);
      filter: none;
    }
    20% {
      transform: translate(-4px, 2px);
      filter: hue-rotate(15deg) brightness(1.1) contrast(1.2);
    }
    60% {
      transform: translate(4px, -2px);
      filter: hue-rotate(-15deg);
    }
  }

  .card-hover-target:hover {
    animation: glitch-shift 0.25s steps(2, start) 1;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("top-projects");
    const container = document.getElementById("cards-container");
    if (!section) return;

    const ctx = gsap.context(() => {
      const controllers = section.querySelectorAll<HTMLElement>(
        ".card-gsap-controller",
      );
      if (controllers.length < 3) return;

      const mm = gsap.matchMedia();

      mm.add(
        {
          isDesktop: "(min-width: 768px)",
          isMobile: "(max-width: 767px)",
        },
        (context) => {
          const { isDesktop } = context.conditions as { isDesktop: boolean };

          const spreadAmount = isDesktop
            ? Math.min(window.innerWidth * 0.28, 340)
            : window.innerWidth * 0.1;

          gsap.set(controllers[0], {
            x: 0,
            xPercent: -55,
            yPercent: -50,
            rotation: -4,
          });
          gsap.set(controllers[1], {
            x: 0,
            xPercent: -50,
            yPercent: -56,
            rotation: 0,
          });
          gsap.set(controllers[2], {
            x: 0,
            xPercent: -45,
            yPercent: -50,
            rotation: 4,
          });

          const finalRotations = [-8, 0, 8];

          // 展開動畫
          controllers.forEach((card, i) => {
            gsap.to(card, {
              x: (i - 1) * spreadAmount,
              y: isDesktop ? 0 : i === 1 ? -40 : i === 2 ? 40 : 120,
              rotation: finalRotations[i],
              ease: "power2.out",
              scrollTrigger: {
                trigger: section,
                start: "top 75%",
                end: "center center",
                scrub: true,
                invalidateOnRefresh: true,
              },
            });
          });

          if (!isDesktop) {
            const zStages = [
              [1, 3, 2],
              [1, 2, 3],
              [3, 2, 1],
            ] as const;

            ScrollTrigger.create({
              trigger: container,
              start: "top 55%",
              end: "top -10%",
              onUpdate(self) {
                const stage =
                  self.progress < 0.50 ? 0 : self.progress < 0.95 ? 1 : 2;
                controllers.forEach((card, i) => {
                  card.style.zIndex = String(zStages[stage][i]);
                });
              },
            });
          }
        },
      );
    }, section);

    document.addEventListener("astro:before-swap", () => ctx.revert(), {
      once: true,
    });
  });
</script>

<style>
  @media (min-width: 767) {
    .hover-top:hover {
      z-index: 30 !important;
    }
  }
</style>
