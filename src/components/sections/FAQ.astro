---
import CommentLabel from "@/components/ui/CommentLabel.astro";
import Accordion from "@/components/ui/Accordion.astro";
import { FAQ_ITEMS } from "@/data/faq";
import ScrambleText from "../ui/ScrambleText.astro";
---

<section id="faq" class="py-24 border-t border-line bg-bg-surface">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">

    <div class="mb-10">
      <CommentLabel text="frequently_asked_questions" />
      <h2 class="text-3xl sm:text-4xl font-black text-ink text-glow-primary mt-2">
        <ScrambleText text="[ FAQ ]"/>
      </h2>
    </div>

    <Accordion items={FAQ_ITEMS} />

  </div>
</section>
