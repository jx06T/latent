---
import CommentLabel from "@/components/ui/CommentLabel.astro";
import ScrambleText from "../ui/ScrambleText.astro";
import AnimatedCounter from "@/components/ui/AnimatedCounter.astro";

interface Props {
  totalProjects?: number;
  totalVotes?: number;
}

const { totalProjects = 150, totalVotes = 444 } = Astro.props;

const STATS = [
  {
    id: "stat-projects",
    label: "TOTAL_PROJECTS",
    value: totalProjects,
    unit: "件",
    desc: "已發佈專題",
  },
  {
    id: "stat-votes",
    label: "ENERGY_VOTES",
    value: totalVotes,
    unit: "票",
    desc: "累積投票人次",
  },
  {
    id: "stat-views",
    label: "TOTAL_VIEWS",
    value: 0, // TODO: add view_count field to schema
    unit: "+",
    desc: "累積瀏覽次數",
  },
];
---

<section id="telemetry" class="relative py-20 overflow-hidden bg-bg-surface border-t border-line">

  <div class="relative z-10 max-w-6xl mx-auto px-[10%]">
    <div class="text-center mb-12">
      <CommentLabel text="system_telemetry" />
      <h2 class="text-2xl sm:text-3xl font-black text-ink mt-2 tracking-widest font-mono">
        <ScrambleText text="[ 2026_LATENT_STATUS ]"/>
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-0 border border-line ">
      {STATS.map((stat, i) => (
        <div class={`relative p-8 sm:p-10 text-center ${i < 2 ? "border-b sm:border-b-0 sm:border-r border-line" : ""}`}>
          <!-- Corner accents -->
          <span class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-accent-500" aria-hidden="true"></span>
          <span class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-accent-500" aria-hidden="true"></span>

          <div
            id={stat.id}
            class="text-5xl sm:text-6xl font-black text-accent-500 tabular-nums font-mono"
          >
             <AnimatedCounter value={stat.value} />
          </div>
          <div class="font-mono text-base text-ink-dim mt-2">{stat.unit}</div>
          <div class="font-mono text-sm text-ink-dim mt-3 tracking-widest uppercase">
          <div class="text-sm text-accent-600 mt-0.5">{stat.desc}</div>
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>