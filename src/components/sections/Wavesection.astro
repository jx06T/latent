---
import { cn } from "@/lib/utils";

interface Props {
  position?: "top" | "bottom" | "both";
  wave?: "sine" | "flow" | "sharp" | "quad" | "tide";
  color?: string;
  class?: string;
}

const {
  position = "top",
  wave = "sine",
  color = "var(--color-bg)",
  class: className = "",
  ...rest
} = Astro.props;

const WAVE_PATHS: Record<string, string> = {
  sine: "M0,40 C180,80 360,0 540,40 C720,80 900,0 1080,40 C1260,80 1380,20 1440,40 L1440,80 L0,80 Z",
  flow: "M0,50 C400,90 800,10 1440,50 L1440,80 L0,80 Z",
  sharp:
    "M0,60 L240,20 L480,60 L720,20 L960,60 L1200,20 L1440,60 L1440,80 L0,80 Z",
  quad: "M0,40 Q360,0 720,40 Q1080,80 1440,40 L1440,80 L0,80 Z",
  tide: "M0,30 C120,70 240,10 360,50 C480,90 600,20 720,40 C840,60 960,10 1080,50 C1200,90 1320,20 1440,30 L1440,80 L0,80 Z",
};

const path = WAVE_PATHS[wave] ?? WAVE_PATHS.sine;
---

<div {...rest} class={cn("relative w-full bg-transparent", className)}>
  {
    (position === "top" || position === "both") && (
      <div class="absolute -top-19.75 left-0 w-full h-20 pointer-events-none">
        <svg
          class="w-full h-full block"
          viewBox="0 0 1440 80"
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="none"
        >
          <path d={path} fill={color} />
        </svg>
      </div>
    )
  }

  <div class="relative z-10">
    <slot />
  </div>

  {
    (position === "bottom" || position === "both") && (
      <div class="absolute -bottom-19.75 left-0 w-full h-20 pointer-events-none">
        <svg
          class="w-full h-full block"
          viewBox="0 0 1440 80"
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="none"
          style="transform:scaleY(-1)"
        >
          <path d={path} fill={color} />
        </svg>
      </div>
    )
  }
</div>
