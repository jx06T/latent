---
import { cn } from "@/lib/utils";
interface NavItem {
  label: string;
  href: string;
  key: string;
}

interface Props {
  active?: "home" | "about" | "projects" | "profile";
  nav?: NavItem[];
  class?: string;
}

const {
  active = "home",
  nav = [
    { key: "home", label: "home", href: "/" },
    { key: "about", label: "about", href: "/about" },
    { key: "projects", label: "projects", href: "/projects/2026" },
    { key: "profile", label: "profile", href: "/profile" },
  ],
  class: className = "",
} = Astro.props;
---

<header
  class={cn(
    "statusbar inline-flex items-center gap-4 fixed top-2 md:top-5 left-1/2 -translate-x-1/2 z-40",
    "rounded-full px-4 py-1.75",
    "border border-line-active bg-bg-elevated",
    "backdrop-blur-sm ",
    "font-mono text-base md:text-lg  text-ink-dim",
    "transition-shadow duration-300 ease-out",
    "hover:shadow-[0_6px_28px_rgba(227,124,70,0.1)]  hover:scale-[1.01] transition-transform duration-300",
    className,
  )}
>
  {/* live signal dot */}
  <span
    class="block size-1.5 rounded-full bg-accent-500 shadow-[0_0_6px_#e37c46] animate-[sb-pulse_1.8s_ease-in-out_infinite] ml-2 mr-1"
    aria-hidden="true"></span>

  {/* nav */}
  {
    nav.map((item) => (
      <a
        href={item.href}
        class:list={[
          "transition-colors duration-150",
          item.key === active
            ? "text-accent-500"
            : "text-ink-dim hover:text-accent-500",
        ]}
        aria-current={item.key === active ? "page" : undefined}
      >
        {item.label}
      </a>
    ))
  }

  {/* views label */}
  <div class="items-center gap-1 hidden md:flex">
    <span class="text-line-active select-none -ml-1 mr-3" aria-hidden="true">
      │
    </span>
    <span class="text-ink-faint text-sm tracking-widest">VIEWS</span>

    {/* animated counter — hydrated by inline script below */}
    <span class="text-accent tabular-nums text-sm mr-2" data-views-counter>0</span>
  </div>
</header>

<style is:global>
  @keyframes sb-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function animateCounter(counter: HTMLElement, target: number) {
    if (reduce) { counter.textContent = target.toLocaleString(); return; }
    const from = Math.max(0, target - 124);
    const dur = 1400;
    const start = performance.now();
    const tick = (t: number) => {
      const k = Math.min(1, (t - start) / dur);
      const eased = 1 - Math.pow(1 - k, 3);
      counter.textContent = Math.round(from + (target - from) * eased).toLocaleString();
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  document.querySelectorAll<HTMLElement>(".statusbar").forEach((bar) => {
    const counter = bar.querySelector<HTMLElement>("[data-views-counter]");
    if (!counter) return;
    fetch("/api/stats.json")
      .then((r) => r.ok ? r.json() : null)
      .then((data) => { if (data?.total_views) animateCounter(counter, data.total_views); })
      .catch(() => {});
  });
</script>
