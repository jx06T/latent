---
import CommentLabel from "@/components/ui/CommentLabel.astro";
import { PARTNERS } from "@/data/partners";
import ScrambleText from "../ui/ScrambleText.astro";
import { ArrowUpRight } from "lucide-react";

// 為了無縫滾動，需要複製三份 (在大螢幕或間距寬時更穩)
const tripled = [...PARTNERS, ...PARTNERS, ...PARTNERS];
const reversed = [...PARTNERS].reverse();
const reversedTripled = [...reversed, ...reversed, ...reversed];
---

<section id="partners" class="py-24 border-t border-line bg-bg overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-12 text-center md:text-left">
    <CommentLabel text="organizers_and_partners" />
    <h2 class="text-2xl sm:text-3xl font-black text-ink mt-2 tracking-tight">
      <ScrambleText text="[ PARTNERS ]" />
    </h2>
  </div>

  <div class="marquee-wrapper overflow-hidden mb-8">
    <div class="marquee-track flex gap-8 sm:gap-16 w-max items-center">
      {
        tripled.map((partner) => {
          const isLink = !!partner.url;
          const Element = isLink ? "a" : "div";

          return (
            <div class="marquee-item shrink-0 group">
              <Element
                href={partner.url}
                target="_blank"
                rel="noopener noreferrer"
                class={`relative block transition-all duration-300 ${isLink ? "cursor-pointer" : "cursor-default"}`}
              >
                {/* 視覺提示：針對手機端，始終顯示一個微小的指示器 */}
                {isLink && (
                  <div class="absolute -top-0.5 right-0.5 z-10 w-5 md:hidden">
                    <ArrowUpRight className=" text-accent-500 inline-block w-full " />
                  </div>
                )}

                {partner.logo ? (
                  <img
                    src={partner.logo}
                    alt={partner.name}
                    class={`h-10 sm:h-14 w-auto object-contain grayscale transition-all duration-300
                  ${isLink ? "opacity-80 md:opacity-70 group-hover:opacity-100" : "opacity-40"}`}
                  />
                ) : (
                  <div
                    class={`font-mono text-sm sm:text-base border-2 px-6 py-3 whitespace-nowrap transition-all duration-300
                  ${
                    partner.role === "主辦"
                      ? "border-accent-500/60 text-accent-400 bg-accent-500/5"
                      : "border-line text-ink-dim"
                  }`}
                  >
                    {partner.role === "主辦" && (
                      <span class="mr-2 text-accent-500">✦</span>
                    )}
                    <span
                      class={`${isLink ? "border-dashed md:border-solid md:group-hover:underline underline-offset-4" : ""}`}
                    >
                      {partner.name}
                    </span>
                  </div>
                )}
              </Element>
            </div>
          );
        })
      }
    </div>
  </div>

  <div class="marquee-wrapper overflow-hidden opacity-60">
    <div
      class="marquee-track marquee-reverse flex gap-12 sm:gap-20 w-max items-center"
    >
      {
        reversedTripled.map((partner) => (
          <div class="marquee-item shrink-0 group">
            {partner.logo ? (
              <img
                src={partner.logo}
                alt={partner.name}
                class="h-8 sm:h-10 w-auto object-contain grayscale opacity-80 group-hover:opacity-100 transition-opacity duration-300"
              />
            ) : (
              <div class="font-mono text-xs sm:text-sm border border-line px-5 py-2.5 whitespace-nowrap text-ink-disabled hover:text-ink hover:border-line-active transition-all duration-300">
                {partner.name}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    /* 因為我們用了 tripled，所以要移動 1/3 的寬度來達成無縫 */
    to {
      transform: translateX(-33.333%);
    }
  }

  .marquee-track {
    animation: marquee-scroll 40s linear infinite;
    will-change: transform;
  }

  .marquee-reverse {
    animation-direction: reverse;
    animation-duration: 50s; /* 第二排慢一點，增加錯落感 */
  }

  /* 滑鼠移入時變慢，方便閱讀 */
  .marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  /* 移動端稍微加快速度 */
  @media (max-width: 640px) {
    .marquee-track {
      animation-duration: 25s;
    }
    .marquee-reverse {
      animation-duration: 35s;
    }
  }
</style>
