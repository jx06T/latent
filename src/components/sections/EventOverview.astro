---
import CommentLabel from "@/components/ui/CommentLabel.astro";
import PanelInfo from "./event/PanelInfo.astro";
import PanelTimeline from "./event/PanelTimeline.astro";
import PanelKeynote from "./event/PanelKeynote.astro";
import PanelCategories from "./event/PanelCategories.astro";
import PanelContact from "./event/PanelContact.astro";

const PANELS = 4;
---

<section
  id="event-overview"
  class="relative overflow-hidden bg-bg h-screen w-full"
>
  <!-- Circuit-board background pattern -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="
    background-image:
      linear-gradient(rgba(116,156,186,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(116,156,186,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    background-position: -1px -1px;
  "
  >
  </div>

  <!-- Section header -->
  <div
    class="absolute top-8 md:top-0 left-0 right-0 z-20 px-6 pt-6 pointer-events-none"
  >
    <CommentLabel text="event_overview" class="text-base md:text-xl" />
  </div>

  <!-- Panel progress dots -->
  <div
    id="panel-dots"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-2"
    aria-hidden="true"
  >
    {
      Array.from({ length: PANELS }).map((_, i) => (
        <div
          class={`panel-dot w-2 h-2 rounded-full transition-colors duration-300 ${i === 0 ? "bg-accent-500" : "bg-line-active"}`}
        />
      ))
    }
  </div>

  <!-- 
    Panels track
    設定 w-max 讓軌道自然往右延伸 
  -->
  <div class="panels-track flex w-max h-screen will-change-transform">
    <div class="w-[30vw] h-screen shrink-0"></div>
    <div
      class="panel-card px-[15vw] h-screen shrink-0 flex items-center border-r border-line/60"
    >
      <div class="w-full h-full max-w-2xl mx-auto py-16 pb-20">
        <PanelInfo />
      </div>
    </div>

    <div
      class="panel-card px-[15vw] h-screen shrink-0 flex items-center border-r border-line/60"
    >
      <div class="w-full h-full max-w-2xl mx-auto py-16 pb-20">
        <PanelTimeline />
      </div>
    </div>

    <div
      class="panel-card px-[15vw] h-screen shrink-0 flex items-center border-r border-line/60"
    >
      <div class="w-full h-full max-w-2xl mx-auto py-16 pb-20">
        <PanelKeynote />
      </div>
    </div>

    <div
      class="panel-card px-[15vw] h-screen shrink-0 flex items-center border-r border-line/60"
    >
      <div class="w-full h-full max-w-2xl mx-auto py-16 pb-20">
        <PanelCategories />
      </div>
    </div>

    <!-- <div class="panel-card px-[15vw] h-screen shrink-0 flex items-center">
      <div class="w-full max-w-2xl mx-auto py-20">
        <PanelContact />
      </div>
    </div> -->
    <div class="w-[30vw] h-screen shrink-0"></div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("event-overview");
    if (!section) return;

    const track = section.querySelector<HTMLElement>(".panels-track");
    const dots = section.querySelectorAll<HTMLElement>(".panel-dot");
    const panels = gsap.utils.toArray<HTMLElement>(".panel-card");
    if (!track || panels.length === 0) return;

    const ctx = gsap.context(() => {
      const getScrollAmount = () => track.scrollWidth - window.innerWidth;

      // 2. 定義一個函數來計算所有卡片「完美置中」的進度點 (0 到 1 之間)
      const getSnapPoints = () => {
        const scrollAmount = getScrollAmount();
        return panels.map((panel) => {
          const panelLeft = panel.offsetLeft;
          const panelWidth = panel.offsetWidth;

          const targetX = panelLeft - (window.innerWidth - panelWidth) / 2;

          const clampedX = Math.max(0, Math.min(targetX, scrollAmount));

          return clampedX / scrollAmount;
        });
      };

      // 3. 建立一個變數儲存當下的進度點陣列
      let currentSnapPoints = getSnapPoints();

      // 4. 建立主要的 ScrollTrigger 與橫向移動動畫
      ScrollTrigger.create({
        trigger: section,
        pin: true,
        scrub: 0.5,
        end: () => "+=" + window.innerHeight * 3,
        invalidateOnRefresh: true,

        onRefresh: () => {
          currentSnapPoints = getSnapPoints();
        },

        // 將軌道往左推的實體動畫
        animation: gsap.to(track, {
          x: () => -getScrollAmount() + "px",
          ease: "none",
        }),

        snap: {
          snapTo: (progress) => gsap.utils.snap(currentSnapPoints, progress),

          duration: { min: 0.1, max: 0.2 },
          delay: 0,
          ease: "power1.inOut",
        },

        onUpdate(self) {
          const progress = self.progress;

          const closestPoint = gsap.utils.snap(currentSnapPoints, progress);
          const closestIndex = currentSnapPoints.indexOf(closestPoint);

          dots.forEach((dot, i) => {
            dot.style.backgroundColor =
              i === closestIndex
                ? "var(--color-accent-500)" // 亮橘色 (亮起)
                : "var(--color-line-active)"; // 灰色 (未亮)
          });
        },
      });
    }, section);

    document.addEventListener("astro:before-swap", () => ctx.revert(), {
      once: true,
    });
  });
</script>
