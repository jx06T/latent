---
import CommentLabel from "@/components/ui/CommentLabel.astro";
import PanelInfo from "./event/PanelInfo.astro";
import PanelTimeline from "./event/PanelTimeline.astro";
import PanelKeynote from "./event/PanelKeynote.astro";
import PanelCategories from "./event/PanelCategories.astro";

const PANELS = 4;
---

<section id="event-overview" class="relative w-full h-[400vh] bg-bg-surface">
  <!-- 黏性視窗層 -->
  <div class="sticky top-0 w-full h-screen overflow-hidden">
    <!-- 背景紋理 -->
    <div
      class="absolute inset-0 pointer-events-none opacity-40"
      aria-hidden="true"
      style="background-image: linear-gradient(rgba(116,156,186,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(116,156,186,0.04) 1px, transparent 1px); background-size: 60px 60px; background-position: -1px -1px;"
    >
    </div>

    <!-- Section header -->
    <div
      class="absolute top-7 md:top-0 left-0 right-0 z-20 px-6 pt-6 pointer-events-none"
    >
      <CommentLabel text="event_overview" class="text-base md:text-xl" />
    </div>

    <!-- 進度圓點 -->
    <div
      id="panel-dots"
      class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex gap-2"
      aria-hidden="true"
    >
      {
        Array.from({ length: PANELS }).map((_, i) => (
          <div
            class={`panel-dot w-2 h-2 rounded-full transition-colors duration-300 ${i === 0 ? "bg-accent-500" : "bg-line-active"}`}
          />
        ))
      }
    </div>

    <div class="panels-track flex h-full will-change-transform items-center">
      <div class="w-[8.3rem] xs:w-[calc(50vw-224px+9.8rem)] lg:w-[calc(50vw-224px+11.3)]  shrink-0 h-full"></div>

      <div
        class="flex justify-start gap-20 xs:gap-30 lg:gap-40 h-full will-change-transform items-center pt-18 pb-18"
      >
        <div
          class="panel-card shrink-0 grow-0 h-full max-w-2xl overflow-y-visible no-scrollbar"
        >
          <PanelInfo />
        </div>

        <div class="w-px border-none h-full bg-line"></div>

        <div
          class="panel-card shrink-0 grow-0 h-full max-w-2xl overflow-y-visible no-scrollbar"
        >
          <PanelTimeline />
        </div>

        <div class="w-px border-none h-full bg-line"></div>

        <div
          class="panel-card shrink-0 grow-0 h-full max-w-2xl overflow-y-visible no-scrollbar"
        >
          <PanelKeynote />
        </div>

        <div class="w-px border-none h-full bg-line"></div>

        <div
          class="panel-card shrink-0 grow-0 h-full max-w-2xl overflow-y-visible no-scrollbar"
        >
          <PanelCategories />
        </div>
      </div>

      <div class="w-[8.3rem] xs:w-[calc(50vw-224px+9.8rem)] lg:w-[calc(50vw-224px+11.3)]  shrink-0 h-full"></div>
    </div>

    <style>
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener("DOMContentLoaded", () => {
        const section = document.getElementById("event-overview");
        if (!section) return;

        const track = section.querySelector<HTMLElement>(".panels-track");
        const dots = section.querySelectorAll<HTMLElement>(".panel-dot");
        const panels = gsap.utils.toArray<HTMLElement>(".panel-card");

        if (!track || panels.length === 0) return;

        const ctx = gsap.context(() => {
          const getScrollAmount = () =>
            track.scrollWidth - document.documentElement.clientWidth;

          const getSnapPoints = () => {
            const scrollAmount = getScrollAmount();
            const vW = document.documentElement.clientWidth;

            return panels.map((panel) => {
              const panelLeft = panel.offsetLeft;
              const panelW = panel.offsetWidth;
              // 置中點 X = 卡片左座標 - (視窗一半 - 卡片一半)
              const targetX = panelLeft - (vW - panelW) / 2;
              const clampedX = Math.max(0, Math.min(targetX, scrollAmount));
              return clampedX / scrollAmount;
            });
          };

          let currentSnapPoints = getSnapPoints();

          // 建立動畫與滾動觸發
          ScrollTrigger.create({
            trigger: section,
            start: "top 20%",
            end: "bottom 80%",
            scrub: true,
            markers: true,
            invalidateOnRefresh: true,

            onRefresh: () => {
              currentSnapPoints = getSnapPoints();
            },

            animation: gsap.to(track, {
              x: () => -getScrollAmount() + "px",
              ease: "none",
            }),

            // snap: {
            //   snapTo: (progress) =>
            //     gsap.utils.snap(currentSnapPoints, progress),
            //   duration: { min: 0.1, max: 0.2 },
            //   delay: 0,
            //   ease: "power1.inOut",
            // },

            onUpdate(self) {
              const progress = self.progress;
              const closestPoint = gsap.utils.snap(currentSnapPoints, progress);
              const closestIndex = currentSnapPoints.indexOf(closestPoint);

              dots.forEach((dot, i) => {
                dot.style.backgroundColor =
                  i === closestIndex
                    ? "var(--color-accent-500)"
                    : "var(--color-line-active)";
              });
            },
          });
        }, section);

        document.addEventListener("astro:before-swap", () => ctx.revert(), {
          once: true,
        });
      });
    </script>
  </div>
</section>
