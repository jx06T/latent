---
import CommentLabel from "@/components/ui/CommentLabel.astro";
import { LinkButton } from "@/components/ui/Button";
---

<section id="cta" class="py-32 border-t border-line bg-bg relative overflow-hidden">

  <!-- Subtle radial glow behind content -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 60% 40% at 50% 60%, rgba(116,156,186,0.06) 0%, transparent 70%);"
  ></div>

  <div class="relative z-10 max-w-2xl mx-auto px-4 sm:px-6 text-center">
    <CommentLabel text="access_databank" class=" text-xl" />

    <h2 class="text-4xl sm:text-5xl font-black text-ink text-glow-primary mt-5 mb-4 leading-tight">
      
      探索所有專題
    </h2>

    <div class="flex flex-col sm:flex-row gap-5 justify-center items-center">
      <LinkButton href="/projects" variant="primary" size="lg" bracket>EXPLORE_DATABANKS</LinkButton>
      <LinkButton href="/contact" variant="outline" size="lg" bracket>SUBMIT_PROJECT</LinkButton>
    </div>
  </div>
</section>
