---
// Shared Lenis + GSAP smooth scroll initializer.
// Import and render once per page/layout that needs smooth scrolling.
---

<script>
  import Lenis from "lenis";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Prevent ScrollTrigger from refreshing when only viewport HEIGHT changes
  // (mobile URL bar show/hide) — width-change events still trigger refresh normally.
  ScrollTrigger.config({ ignoreMobileResize: true });

  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    smoothWheel: true,
    touchMultiplier: 2,
  });

  lenis.on("scroll", ScrollTrigger.update);

  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
  });

  gsap.ticker.lagSmoothing(0);

  // Take manual control so Lenis and the browser don't fight over scroll position
  // on back/forward navigation.
  history.scrollRestoration = "manual";

  // Save Lenis scroll position before the page unloads
  window.addEventListener("pagehide", () => {
    sessionStorage.setItem(
      `lenis-scroll:${location.pathname}`,
      String(Math.round(lenis.scroll)),
    );
  });

  // Restore scroll after pageshow (double-rAF lets layout settle before scrollTo)
  window.addEventListener("pageshow", () => {
    const saved = sessionStorage.getItem(`lenis-scroll:${location.pathname}`);
    const y = saved ? parseInt(saved, 10) : 0;

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (y > 0) lenis.scrollTo(y, { immediate: true });
        ScrollTrigger.refresh();
      });
    });
  });

  // Safety net: refresh after fonts load to fix any stale trigger positions
  document.fonts.ready.then(() => ScrollTrigger.refresh());

  document.addEventListener("astro:before-swap", () => {
    lenis.destroy();
  });
</script>
