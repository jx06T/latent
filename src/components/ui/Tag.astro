---
// src/components/ui/Tag.astro
import { cn } from "@/lib/utils";

interface Props {
  variant?: "main" | "sub" | "official" | "community" | "exhibition";
  class?: string;
}

const { variant = "main", class: className } = Astro.props;

const styles = {
  main:       "bg-accent-500 text-bg shadow-accent-sm",
  sub:        "border text-ink-dim hover:border-solid-cyber transition-colors",
  official:   "border border-success text-success bg-success-ghost",
  community:  "border border-line text-ink-ddim",
  exhibition: "border border-warning text-warning bg-warning-ghost",
};
---

<span class={cn("inline-block px-2 py-0.5 pt-1 text-base", styles[variant], className)}>
  <slot />
</span>


