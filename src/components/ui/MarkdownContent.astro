---
import { createMarkedInstance } from "@/lib/markdown-renderer";
import sanitizeHtml from "sanitize-html";

interface Props {
  content: string;
  class?: string;
}

const { content, class: className = "" } = Astro.props;

const rawHtml = await createMarkedInstance().parse(content || "");

// Rejects any CSS value containing url( — blocks tracking pixels via cursor/background etc.
const noUrl = /^(?![\s\S]*url\s*\()[\s\S]+$/i;

// 執行安全過濾
const cleanHtml = sanitizeHtml(rawHtml, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat([
    "img",
    "iframe",
    "svg",
    "path",
    "span",
    "div",
    "video",
    "source",
  ]),
  transformTags: {
    video: (tagName, attribs) => {
      // 1. 如果有 autoplay，但沒有 muted，我們強制幫它加上
      if ("autoplay" in attribs && !("muted" in attribs)) {
        attribs.muted = ""; // 這會在 HTML 中產生 <video autoplay muted>
      }

      // 在 iOS (iPhone) 上，影片如果有 autoplay，必須同時具備 muted 和 playsinline 才會生效。
      if ("autoplay" in attribs && !("playsinline" in attribs)) {
        attribs.playsinline = "";
      }

      // 2. 關於下一個問題：我們也可以在這裡強制規範 preload 的值
      if (attribs.preload === "auto") {
        attribs.preload = "metadata"; // 強制降級，避免消耗流量
      }

      return {
        tagName,
        attribs,
      };
    },
  },
  allowedIframeDomains: [
    "youtube.com",
    "www.youtube.com",
    "youtube-nocookie.com",
    "vimeo.com",
    "player.vimeo.com",
    "codepen.io",
    "stackblitz.com",
    "codesandbox.io",
  ],
  allowedClasses: {
    div: [
      "callout",
      "callout-note",
      "callout-tip",
      "callout-warning",
      "callout-caution",
      "callout-danger",
      "callout-important",
      "callout-title",
      "callout-icon",
      "callout-body",
    ],
  },
  allowedStyles: {
    "*": {
      // 顏色
      color: [noUrl],
      "background-color": [noUrl],
      // 字體
      "font-size": [noUrl],
      "font-weight": [noUrl],
      "font-family": [noUrl],
      "font-style": [noUrl],
      "line-height": [noUrl],
      "letter-spacing": [noUrl],
      // 文字
      "text-decoration": [noUrl],
      "text-align": [noUrl],
      "text-transform": [noUrl],
      "text-overflow": [noUrl],
      "text-shadow": [noUrl],
      "text-indent": [noUrl],
      "white-space": [noUrl],
      "word-break": [noUrl],
      "overflow-wrap": [noUrl],
      "vertical-align": [noUrl],
      // 排版
      display: [noUrl],
      "align-items": [noUrl],
      "justify-content": [noUrl],
      "flex-direction": [noUrl],
      "flex-wrap": [noUrl],
      flex: [noUrl],
      gap: [noUrl],
      "grid-template-columns": [noUrl],
      "grid-template-rows": [noUrl],
      // 間距
      padding: [noUrl],
      margin: [noUrl],
      // 邊框
      border: [noUrl],
      "border-radius": [noUrl],
      "border-color": [noUrl],
      "border-width": [noUrl],
      "border-style": [noUrl],
      // 尺寸（wrapper 層的 overflow-x: hidden 防止撐版）
      width: [noUrl],
      height: [noUrl],
      "max-width": [noUrl],
      "max-height": [noUrl],
      "min-width": [noUrl],
      "min-height": [noUrl],
      "aspect-ratio": [noUrl],
      // 圖片
      "object-fit": [noUrl],
      "object-position": [noUrl],
      // 其他
      cursor: [noUrl],
      // 不列入：position、z-index、top/right/bottom/left、transform、opacity、background (url)、filter、overflow
    },
  },
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    "*": ["class", "style"],
    h1: ["id"],
    h2: ["id"],
    h3: ["id"],
    h4: ["id"],
    h5: ["id"],
    h6: ["id"],
    a: ["href", "title", "target", "rel", "class"],
    img: ["src", "alt", "title", "loading", "class"],
    iframe: [
      "src",
      "allowfullscreen",
      "title",
      "frameborder",
      "width",
      "height",
    ],
    svg: [
      "xmlns",
      "width",
      "height",
      "viewBox",
      "fill",
      "stroke",
      "stroke-width",
      "stroke-linecap",
      "stroke-linejoin",
      "class",
    ],
    path: ["d"],
    video: [
      "src",
      "controls", // 允許顯示控制條
      "width",
      "height",
      "poster", // 允許影片封面圖
      "muted", // 允許靜音
      "loop", // 允許迴圈播放
      "playsinline", // 確保在 iOS Safari 上不會強制全螢幕
      "preload", // 可選，建議只允許 "none" 或 "metadata" 以省頻寬
      "autoplay",
    ],
    source: ["src", "type"],
  },
});
---

<div
  class={`prose prose-invert max-w-none wrap-anywhere overflow-x-hidden ${className}`}
  set:html={cleanHtml}
/>
