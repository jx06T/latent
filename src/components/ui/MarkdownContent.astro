---
import { createMarkedInstance } from "@/lib/markdown-renderer";
import sanitizeHtml from "sanitize-html";

interface Props {
  content: string;
  class?: string;
}

const { content, class: className = "" } = Astro.props;

const rawHtml = await createMarkedInstance().parse(content || "");

// 執行安全過濾
const cleanHtml = sanitizeHtml(rawHtml, {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat([
    "img",
    "iframe",
    "svg",
    "path",
    "span",
    "div",
  ]),
  allowedClasses: {
    div: [
      "callout", "callout-note", "callout-tip", "callout-warning",
      "callout-caution", "callout-danger", "callout-important",
      "callout-title", "callout-icon", "callout-body",
    ],
  },
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    "*": ["class", "style"],
    a: ["href", "title", "target", "rel", "class"],
    img: ["src", "alt", "title", "loading", "class"], // 記得允許 img 的 loading 屬性
    svg: [
      "xmlns",
      "width",
      "height",
      "viewBox",
      "fill",
      "stroke",
      "stroke-width",
      "stroke-linecap",
      "stroke-linejoin",
      "class",
    ],
    path: ["d"],
  },
});
---

<div
  class={`prose prose-invert max-w-none ${className}`}
  set:html={cleanHtml}
/>
