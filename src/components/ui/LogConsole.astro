---
// LogConsole：黑色區域內的終端機 log 串流
// 在 WaveSection variant="hero" 的 slot 中使用

interface LogEntry {
  level: "OK" | "INFO" | "WARN" | "ERR";
  message: string;
  delay: number; // ms
}

const logs: LogEntry[] = [
  { level: "OK", message: "classified in 5.3ms", delay: 0 },
  { level: "OK", message: "classified in 11.2ms", delay: 300 },
  { level: "INFO", message: "obj classified: 3/4", delay: 600 },
  { level: "ERR", message: "timeout", delay: 900 },
  { level: "INFO", message: "retrying... (1/2)", delay: 1200 },
  { level: "WARN", message: "distribution shift", delay: 1500 },
  { level: "INFO", message: "retrying... (2/2)", delay: 1800 },
  { level: "ERR", message: "index out of bounds", delay: 2100 },
  { level: "ERR", message: "classification failed", delay: 2400 },
];

const levelClass: Record<LogEntry["level"], string> = {
  OK: "log--ok",
  INFO: "log--info",
  WARN: "log--warn",
  ERR: "log--err",
};
---

<div
  class="log-console"
  data-log-console
  aria-label="System log output"
  role="log"
>
  <ul class="log-list" aria-live="polite">
    {
      logs.map((entry) => (
        <li
          class={`log-entry ${levelClass[entry.level]}`}
          data-log-delay={entry.delay}
          aria-hidden="true"
          style="opacity: 0; transform: translateX(-6px);"
        >
          <span class="log-level">[{entry.level}]</span>
          <span class="log-message">{entry.message}</span>
        </li>
      ))
    }
  </ul>

  <!-- 游標閃爍 -->
  <span class="log-cursor" aria-hidden="true">█</span>
</div>

<style>
  .log-console {
    padding: 2rem 1.5rem 1.5rem;
    font-family: "IBM Plex Mono", "Courier New", monospace;
    font-size: clamp(0.8rem, 2.5vw, 1rem);
    line-height: 1.9;
    color: #a8a090;
    user-select: none;
  }

  .log-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .log-entry {
    display: flex;
    gap: 0.75em;
    white-space: nowrap;
    overflow: hidden;
    /* 個別動畫由 GSAP 在 ScrollTrigger onEnter 時觸發 */
  }

  .log-level {
    min-width: 6em;
    display: inline-block;
  }

  /* 顏色系統 */
  .log--ok .log-level {
    color: #6a8a5a;
  }
  .log--info .log-level {
    color: #7a8a9a;
  }
  .log--warn .log-level {
    color: #b89040;
  }
  .log--err {
    background: rgba(180, 40, 30, 0.12);
    border-left: 2px solid #8a2010;
    padding-left: 0.4em;
    margin-left: -0.4em;
  }
  .log--err .log-level {
    color: #c04030;
  }
  .log--err .log-message {
    color: #c8a090;
  }

  .log-message {
    color: #7a7060;
  }

  /* 游標 */
  .log-cursor {
    display: inline-block;
    color: #c8601a;
    font-size: 0.9em;
    animation: cursorBlink 1.1s step-end infinite;
    opacity: 0;
  }

  @keyframes cursorBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
