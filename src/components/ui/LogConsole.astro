---
interface LogEntry {
  level: "OK" | "INFO" | "WARN" | "ERR";
  message: string;
  delay: number;
}

const logs: LogEntry[] = [
  { level: "OK", message: "classified in 5.3ms", delay: 0 },
  { level: "OK", message: "classified in 11.2ms", delay: 300 },
  { level: "INFO", message: "obj classified: 3/4", delay: 600 },
  { level: "ERR", message: "timeout", delay: 900 },
  { level: "INFO", message: "retrying... (1/2)", delay: 1200 },
  { level: "WARN", message: "distribution shift", delay: 1500 },
  { level: "INFO", message: "retrying... (2/2)", delay: 1800 },
  { level: "ERR", message: "index out of bounds", delay: 2100 },
  { level: "ERR", message: "classification failed", delay: 2400 },
];

const levelClass: Record<LogEntry["level"], string> = {
  OK: "log--ok",
  INFO: "log--info",
  WARN: "log--warn",
  ERR: "log--err",
};
---

<div
  class="pt-8 px-6 pb-6 text-[clamp(0.8rem,2.5vw,1rem)] leading-[1.9] text-[#a8a090] select-none"
  style="font-family: 'IBM Plex Mono', 'Courier New', monospace;"
  data-log-console
  aria-label="System log output"
  role="log"
>
  <ul class="list-none m-0 p-0" aria-live="polite">
    {
      logs.map((entry) => (
        <li
          class={`log-entry ${levelClass[entry.level]}`}
          data-log-delay={entry.delay}
          aria-hidden="true"
          style="opacity: 0; transform: translateX(-6px);"
        >
          <span class="log-level">[{entry.level}]</span>
          <span class="log-message">{entry.message}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Structural — used by both static HTML and JS-created entries */
  .log-entry {
    @apply flex gap-[0.75em] whitespace-nowrap overflow-hidden;
  }
  .log-level {
    @apply min-w-[6em] inline-block;
  }

  /* Color tokens — descendant selectors can't move to Tailwind cleanly */
  .log-message {
    color: #7a7060;
  }
  .log--ok .log-level {
    color: #6a8a5a;
  }
  .log--info .log-level {
    color: #7a8a9a;
  }
  .log--warn .log-level {
    color: #b89040;
  }

  .log--err {
    background: rgba(180, 40, 30, 0.12);
    border-left: 2px solid #8a2010;
    padding-left: 0.4em;
    margin-left: -0.4em;
  }
  .log--err .log-level {
    color: #c04030;
  }
  .log--err .log-message {
    color: #c8a090;
  }

  @keyframes cursorBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
