---
import { initialLogs } from "../hero/log-data";

const levelClass = {
  OK:   "log--ok",
  INFO: "log--info",
  WARN: "log--warn",
  ERR:  "log--err",
} as const;
---

<div
  class="pt-8 px-6 pb-6 text-[clamp(0.8rem,2.5vw,1rem)] leading-[1.9] text-[#a8a090] select-none"
  style="font-family: 'IBM Plex Mono', 'Courier New', monospace;"
  data-log-console
  aria-label="System log output"
  role="log"
>
  <ul class="log-list list-none m-0 p-0" aria-live="polite">
    {
      initialLogs.map((entry) => (
        <li
          class={`log-entry ${levelClass[entry.level]}`}
          data-log-delay={entry.delay}
          aria-hidden="true"
          style="opacity: 0; transform: translateX(-6px);"
        >
          <span class="log-level">[{entry.level}]</span>
          <span class="log-message">{entry.message}</span>
        </li>
      ))
    }
  </ul>
</div>

<style is:global>
  .log-list {
    contain: layout paint; 
  }

  .log-entry {
    @apply flex gap-[0.75em] whitespace-nowrap overflow-hidden;
    will-change: transform, opacity;
    transform: translateZ(0);
  }

  .log-entry {
    @apply flex gap-[0.75em] whitespace-nowrap overflow-hidden;
  }
  .log-level {
    @apply min-w-[6em] inline-block;
  }

  .log-message          { color: #a39b8d; }
  .log--ok   .log-level { color: #6a8a5a; }
  .log--info .log-level { color: #7a8a9a; }
  .log--warn .log-level { color: #b89040; }

  .log--err {
    background: rgba(180, 40, 30, 0.12);
    border-left: 2px solid #8a2010;
    padding-left: 0.4em;
    margin-left: -0.4em;
  }
  .log--err .log-level   { color: #c04030; }
  .log--err .log-message { color: #c8a090; }
</style>
