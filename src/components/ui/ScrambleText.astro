---
// src/components/ui/ScrambleText.astro
import { cn } from "@/lib/utils";

interface Props {
  text: string;
  class?: string;
  duration?: number; // 總解碼時間
  trigger?: "load" | "hover" | "scroll";
}

const {
  text,
  class: className,
  duration = 1.0,
  trigger = "scroll",
} = Astro.props;
---

<span class:list={["scramble-wrapper relative inline-block", className]}>
  <!-- 隱形佔位層：撐開寬度，防止晃動 -->
  <span class="invisible-ghost invisible select-none" aria-hidden="true"
    >{text}</span
  >

  <!-- 視覺輸出層：實際看到的動畫 -->

  <span
    class={cn("scramble-display absolute top-0 left-0", className)}
    data-scramble={text}
    data-duration={duration}
    data-trigger={trigger}
  >
  </span>
</span>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const CHARS =
    "ギャアアイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789!<>-_\\/[]{}—=+*^?#";

  function getRandomChar() {
    return CHARS[Math.floor(Math.random() * CHARS.length)];
  }

  function initScramble() {
    const elements = document.querySelectorAll(
      ".scramble-display:not(.is-initialized)",
    );

    elements.forEach((el) => {
      const target = el as HTMLElement;
      target.classList.add("is-initialized");

      const finalText = target.dataset.scramble || "";
      const duration = parseFloat(target.dataset.duration || "1.0");
      const triggerType = target.dataset.trigger;

      const runAnimation = () => {
        let obj = { progress: 0 };

        gsap.to(obj, {
          progress: finalText.length,
          duration: duration,
          ease: "none", // 線性增加字符感
          onUpdate: () => {
            const currentIndex = Math.floor(obj.progress);
            // 已鎖定的正確字元
            const lockedText = finalText.slice(0, currentIndex);

            // 正在變化的最後一個字元 (增加隨機感)
            let scramblingChar = "";
            if (currentIndex < finalText.length) {
              scramblingChar = getRandomChar();
            }

            target.innerText = lockedText + scramblingChar;
          },
          onComplete: () => {
            target.innerText = finalText;
          },
        });
      };

      if (triggerType === "scroll") {
        ScrollTrigger.create({
          trigger: target,
          start: "top 95%",
          onEnter: runAnimation,
          once: true,
        });
      } else if (triggerType === "load") {
        setTimeout(runAnimation, 100);
      } else if (triggerType === "hover") {
        target.parentElement?.addEventListener("mouseenter", runAnimation, {
          once: true,
        });
      }
    });
  }

  initScramble();
  document.addEventListener("astro:page-load", initScramble);
</script>

<style>
  .scramble-wrapper {
    /* 確保容器寬度由隱形文字決定 */
    vertical-align: bottom;
  }

  .scramble-display {
    white-space: nowrap;
    color: inherit;
  }
</style>
