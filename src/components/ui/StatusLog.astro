---
// src/components/ui/StatusLog.astro
import { cn } from "@/lib/utils";

interface Props {
  type?: "success" | "warning" | "error";
  message?: string; // 設為可選，方便 template 使用
  timestamp?: string;
  class?: string;
}

const {
  type = "success",
  message = "",
  timestamp = "+0.000s",
  class: className,
} = Astro.props;

const statusMap = {
  success: { label: "OK", color: "text-success", bg: "bg-success" },
  warning: { label: "WARN", color: "text-warning", bg: "bg-warning" },
  error: { label: "ERR", color: "text-danger", bg: "bg-danger" },
};

const s = statusMap[type];
---

<div
  class={cn(
    "js-log-root inline-flex items-center gap-3 bg-bg-surface border border-line p-1.5 px-3 min-w-75 font-mono text-sm relative overflow-hidden group",
    className,
  )}
>
  <!-- 狀態指示燈 [ • ] -->
  <span class={cn("js-log-color flex items-center gap-1", s.color)}>
    <span class="opacity-70">[</span>
    <span
      class={cn("js-log-bg w-1.5 h-1.5 rounded-full inline-block -mb-0.5", s.bg)}
      style="box-shadow: 0 0 6px currentColor"
    ></span>
    <span class={cn("js-log-color-text mb-0 text-xs tracking-widest h-4 flex items-center", s.color)}>
      <span class="js-log-label">{s.label}</span>
    </span>
    <span class="opacity-70">]</span>
  </span>

  <!-- 訊息內容 -->
  <span class="js-log-msg text-ink flex-1 truncate">
    {message}
  </span>

  <!-- 時間戳 -->
  <span class="js-log-time text-ink-dim/40 text-[10px]">
    {timestamp}
  </span>

  <!-- 背景掃描線閃爍效果 (可選) -->
  <div class="absolute inset-0 bg-white/5 opacity-0 group-hover:opacity-100 pointer-events-none"></div>
</div>