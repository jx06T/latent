---
// src/components/ui/LatentLogo.astro
import laSvg from "@/assets/ic.svg?raw";
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
  [key: string]: any; // 允許傳入 data-parallax 等任意屬性
}

const { class: className, ...rest } = Astro.props;
---

<div 
  class={cn("logo-wrapper inline-flex justify-center items-center", className)} 
  {...rest}
>
  <Fragment set:html={laSvg} />
</div>

<style>
  /* --- 關鍵：強制覆寫 SVG 預設行為 --- */
  
  /* 1. 讓 SVG 填滿我們設定的 Tailwind 寬高 */
  .logo-wrapper :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* 2. 強制所有路徑的顏色跟隨 Tailwind 的 text-color */
  .logo-wrapper :global(svg path),
  .logo-wrapper :global(svg rect),
  .logo-wrapper :global(svg polygon),
  .logo-wrapper :global(svg circle) {
    fill: currentColor; /* 這樣才能吃得到 text-accent-500 等顏色 */
    /* 如果你的 SVG 是描邊畫的，請加這行： */
    /* stroke: currentColor; */
    transition: fill 0.3s ease; /* 變色時有平滑動畫 */
  }
</style>