---
const scanBoxes = [
  {
    id: "fish",
    label: "[ fish | 93% ]",
    x: "15%",
    y: "60%",
    w: "15%",
    h: "8%",
    speed: 0.2,
  },
  {
    id: "cloud",
    label: "[ cloud | 75% ]",
    x: "70%",
    y: "15%",
    w: "12%",
    h: "6%",
    speed: 0.7,
  },
  {
    id: "earth",
    label: "[ earth | 57% ]",
    x: "15%",
    y: "80%",
    w: "12%",
    h: "12%",
    speed: 0.3,
  },
];

const boxesWithCenters = scanBoxes.map((box) => {
  const cx = parseFloat(box.x) + parseFloat(box.w) / 2;
  const cy = parseFloat(box.y) + parseFloat(box.h) / 2;
  return { ...box, cx: `${cx}%`, cy: `${cy}%` };
});

const initStyle = [
  "--parallax-y: 0px",
  "--float-x: 0px",
  "--float-y: 0px",
  "--scale-x: 1",
  "--scale-y: 1",
].join("; ");
---

<svg
  data-scanner-svg
  class="absolute inset-0 w-full h-full pointer-events-none z-20"
>
  <defs>
    <clipPath id="scan-mask">
      {
        boxesWithCenters.map((box) => (
          <rect
            data-mask-target={box.id}
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
            fill="white"
            style={
              initStyle + `; --origin-x: ${box.cx}; --origin-y: ${box.cy};`
            }
            class="math-transform"
          />
        ))
      }
    </clipPath>
  </defs>

  <g id="connection-lines">
    {
      boxesWithCenters.map((box) => (
        <line data-line-target={box.id} stroke="#d18e12" stroke-width="1.5" />
      ))
    }
  </g>

  <g id="visual-boxes">
    {
      boxesWithCenters.map((box) => (
        <svg
          data-visual-target={box.id}
          data-speed={box.speed}
          x={box.x}
          y={box.y}
          width={box.w}
          height={box.h}
          overflow="visible"
          opacity="0"
          style={initStyle + `; --origin-x: ${box.cx}; --origin-y: ${box.cy};`}
          class="math-transform"
        >
          <rect
            x="0"
            y="0"
            width="100%"
            height="100%"
            fill="none"
            stroke="#d18e12"
            stroke-width="2"
          />
          <g data-label-target={box.id} opacity="0">
            <rect x="0" y="-24" width="120" height="24" fill="#d18e12" />
            <text
              x="6"
              y="-8"
              fill="#111"
              font-size="12"
              font-family="monospace"
              font-weight="bold"
            >
              {box.label}
            </text>
          </g>
        </svg>
      ))
    }
  </g>
</svg>

<style>
  .math-transform {
    transform-origin: var(--origin-x) var(--origin-y);
    will-change: transform, translate, scale;

    translate: var(--float-x) calc(var(--parallax-y) + var(--float-y));
    scale: var(--scale-x) var(--scale-y);
  }
</style>
