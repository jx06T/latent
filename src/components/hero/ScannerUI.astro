---
const scanBoxes = [
  {
    id: "fish",
    label: "[ #03 fish 93% ]",
    x: "15%",
    y: "60%",
    w: "15%",
    h: "8%",
    speed: 0.2,
  },
  {
    id: "cloud",
    label: "[ #07 cloud 75% ]",
    x: "70%",
    y: "15%",
    w: "12%",
    h: "6%",
    speed: 0.7,
  },
  {
    id: "earth",
    label: "[ #99 earth 57% ]",
    x: "15%",
    y: "80%",
    w: "12%",
    h: "12%",
    speed: 0.3,
  },
];
---

<svg
  data-scanner-svg
  class="absolute inset-0 w-full h-full pointer-events-none z-20"
>
  <defs>
    <clipPath id="scan-mask">
      {
        scanBoxes.map((box) => (
          <rect
            data-scanner-mask={box.id}
            x={box.x}
            y={box.y}
            width={box.w}
            height={box.h}
            fill="white"
            class="mask-rect"
          />
        ))
      }
    </clipPath>
  </defs>

  <g id="connection-lines">
    {
      scanBoxes.map((box) => (
        <line data-scanner-line={box.id} stroke="#d18e12" stroke-width="1.5" />
      ))
    }
  </g>

  <g id="scanner-boxes">
    {
      scanBoxes.map((box) => (
        <svg
          data-scanner-wrapper={box.id}
          data-speed={box.speed}
          x={box.x}
          y={box.y}
          width={box.w}
          height={box.h}
          overflow="visible"
          class="scanner-wrapper"
        >
          <rect x="0" y="0" width="100%" height="100%" fill="transparent" />

          <g
            data-scanner-frame={box.id}
            class="scanner-frame"
            x="0"
            y="0"
            width="100%"
            height="100%"
            overflow="visible"
          >
            <rect
              data-scanner-box={box.id}
              class="scanner-box"
              x="0"
              y="0"
              width="100%"
              height="100%"
              fill="none"
              stroke="#d18e12"
              stroke-width="2"
            />

            <defs>
              <clipPath id={`label-mask-${box.id}`}>
                <rect
                  data-scanner-label-mask={box.id}
                  x="-1"
                  y="-24"
                  width="120"
                  height="24"
                  style="scale: 0 1;"
                />
              </clipPath>
            </defs>

            <g
              data-scanner-label={box.id}
              clip-path={`url(#label-mask-${box.id})`}
            >
              <rect x="-1" y="-24" width="120" height="24" fill="#d18e12" />
              <text
                x="6"
                y="-8"
                fill="#111"
                font-size="13"
                font-family="Ubuntu"
              >
                {box.label}
              </text>
            </g>
          </g>
        </svg>
      ))
    }
  </g>
</svg>

<style>
  .mask-rect {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    will-change: transform;

    transform: translate(
        var(--float-x, 0px),
        calc(var(--parallax-y, 0px) + var(--float-y, 0px))
      )
      scale(var(--scale-x, 0), var(--scale-y, 0.01));
  }

  .scanner-wrapper {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    will-change: transform;

    translate: 0 var(--parallax-y, 0px);
  }

  .scanner-frame {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    will-change: transform;

    translate: var(--float-x, 0px) var(--float-y, 0px);
  }
  .scanner-box {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    will-change: transform;

    scale: var(--scale-x, 0) var(--scale-y, 0.01);
  }
</style>
