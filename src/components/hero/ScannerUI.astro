---
import { scanBoxes } from "./hero-data";
---

<svg
  data-scanner-svg
  class="absolute inset-0 w-full h-full pointer-events-none z-20"
>
  <defs>
    <clipPath id="scan-mask">
      {
        scanBoxes.map((box) => (
          <rect
            data-scanner-mask={box.id}
            x={`${box.x}%`}
            y={`${box.y}%`}
            width={box.w}
            height={box.h}
            fill="white"
            class="mask-rect"
          />
        ))
      }
    </clipPath>
  </defs>

  <g id="connection-lines">
    {
      scanBoxes.map((box) => (
        <line data-scanner-line={box.id} stroke="#d18e12" stroke-width="2" />
      ))
    }
  </g>

  <g id="scanner-label">
    {
      scanBoxes.map((box) => (
        <svg
          data-scanner-label={box.id}
          x={`${box.x}%`}
          y={`${box.y}%`}
          overflow="visible" 
        >
          <defs>
            <clipPath id={`label-mask-${box.id}`}>
              <rect
                data-scanner-label-mask={box.id}
                x="-1"
                y="-24"
                width="210"
                height="24"
              />
            </clipPath>
          </defs> 

          <g clip-path={`url(#label-mask-${box.id})`}>
            <rect
              x="-1"
              y="-24"
              fill="#d18e12"
              class="translate-y-1.5 md:translate-y-1 lg:translate-y-0 w-31.25 h-4.5 md:w-37.5 md:h-5 lg:w-45 lg:h-6 xl:w-50 xl:h-7 xl:-translate-y-1"
            />
            <text
              x="6"
              y="-8"
              fill="#111"
              font-family="Ubuntu"
              class="translate-y-0.5 md:translate-y-px lg:translate-y-0 text-[11px] md:text-[13px] lg:text-[16px] xl:text-[18px]"
            >
              {box.label}{" "}
              <tspan data-scanner-conf={box.id}>
                {String(box.confidence).padStart(2, "0")}%
              </tspan>{" "}
              ]
            </text>
          </g>
        </svg>
      ))
    }
  </g>

  <g id="scanner-boxes">
    {
      scanBoxes.map((box) => (
        <svg
          data-scanner-wrapper={box.id}
          x={`${box.x}%`}
          y={`${box.y}%`}
          width={box.w}
          height={box.h}
          overflow="visible"
          class="scanner-wrapper"
        >
          <g
            data-scanner-frame={box.id}
            class="scanner-frame"
            x="0"
            y="0"
            width="100%"
            height="100%"
            overflow="visible"
          >
            <rect
              data-scanner-box={box.id}
              class="scanner-box"
              x="0"
              y="0"
              width="100%"
              height="100%"
              fill="none"
              stroke="#d18e12"
              stroke-width="2"
            />
          </g>
        </svg>
      ))
    }
  </g>
</svg>

<style>
  /* 只需要維持 GPU 加速宣告即可，所有的動畫邏輯都交給 JS */
  .mask-rect,
  .scanner-frame,
  .scanner-box {
    will-change: transform;
  }
</style>