---
import StaticBackground from "./StaticBackground.astro";
import FloatingElements from "./FloatingElements.astro";
import ScannerUI from "./ScannerUI.astro";
---

<section
  data-hero
  class="relative w-full h-[250vh] overflow-hidden bg-[#d18e12]"
>
  <StaticBackground />
  <FloatingElements type="normal" />

  <div
    class="absolute inset-0 w-full h-full pointer-events-none"
    style="clip-path: url(#scan-mask);"
  >
    <FloatingElements type="pixel" />
  </div>

  <ScannerUI />
</section>

<section
  class="w-full h-[150vh] p-32 bg-gray-900 text-white flex items-center justify-center text-4xl"
>
  我是下一個 Section (往下滾動時，上面的 Hero 會自然往上滑)
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { getHeroElements, SELECTORS } from "./dom-registry";

  gsap.registerPlugin(ScrollTrigger);

  function initHeroParallax() {
    const heroSection = document.querySelector<HTMLElement>(SELECTORS.hero);
    if (!heroSection) return;

    // 呼叫收集器，準備好所有元素地圖給未來的動畫用
    const els = getHeroElements(heroSection);

    // Context 是為了 Astro 換頁時能一次清理所有動畫
    const ctx = gsap.context(() => {
      els.floatingElements.forEach((el) => {
        // 讀取視差速度設定
        const speed = parseFloat(el.getAttribute("data-speed") || "0");
        if (speed === 0) return;

        gsap.to(el, {
          y: () => -window.innerHeight * speed * 1.5,
          ease: "none",
          scrollTrigger: {
            trigger: heroSection,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
        });
      });

      // ================================================

      if (els.scanner.svg && els.scanner.visuals.length > 0) {
        els.scanner.visuals.forEach((visual) => {
          const id = visual.getAttribute("data-visual-target");
          const mask = document.querySelector(`[data-mask-target="${id}"]`);
          const label = visual.querySelector(`[data-label-target="${id}"]`);
          const speed = parseFloat(visual.getAttribute("data-speed") || "0");

          // 一個工作小組，CSS 變數統一驅動 visual 和 mask
          const pair = [visual, mask];

          gsap.set(pair, {
            "--scale-x": 0,
            "--scale-y": 0.02,
          });
          gsap.set(label, { transformOrigin: "50% 0%", scaleX: 0, opacity: 0 });

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: visual,
              start: "top 80%",
              end: "bottom 35%",
              toggleActions: "play reverse play reverse",
              markers: true,
            },
          });

          tl.to(visual, { opacity: 1, duration: 0.1 })
            .to(pair, { "--scale-x": 1, duration: 0.4, ease: "power4.out" })
            .to(
              pair,
              { "--scale-y": 1, duration: 0.6, ease: "power3.out" },
              "-=0.2",
            )
            .to(label, { opacity: 1, duration: 0.7 }, "-=0.3")
            .to(label, { scaleX: 1, duration: 0.3 }, "-=0.3");

          if (speed !== 0) {
            gsap.to(pair, {
              "--parallax-y": () => `${-window.innerHeight * speed * 1.5}px`,
              ease: "none",
              scrollTrigger: {
                trigger: heroSection,
                start: "top top",
                end: "bottom top",
                scrub: true,
              },
            });
          }

          function randomFloat() {
            gsap.to(pair, {
              "--float-x": `${gsap.utils.random(-30, 30)}px`,
              "--float-y": `${gsap.utils.random(-30, 30)}px`,
              duration: gsap.utils.random(2, 3),
              ease: "sine.inOut",
              onComplete: randomFloat,
            });
          }

          randomFloat();
        });
      }
    }, heroSection);

    // 清理機制：切換頁面時殺掉這個頁面的 GSAP 動畫，防止記憶體洩漏
    document.addEventListener(
      "astro:before-swap",
      () => {
        ctx.revert();
      },
      { once: true },
    );
  }

  // 確保 DOM 載入後執行
  document.addEventListener("DOMContentLoaded", initHeroParallax);
</script>
