---
import StaticBackground from "./StaticBackground.astro";
import FloatingElements from "./FloatingElements.astro";
import ScannerUI from "./ScannerUI.astro";
import UfoSystem from "./UfoSystem.astro";
import LatentLogo from "../ui/LatentLogo.astro";
import LogConsole from "../ui/LogConsole.astro";
import Wavesection from "../sections/Wavesection.astro";
---

<section
  data-hero
  class="relative w-full h-[160vh] md:h-[180vh] lg:h-[220vh] xl:h-[240vh] 2xl:h-[260vh] overflow-hidden bg-[#b5ae9e] min-h-300"
>
  <div
    class="inset-0 absolute w-full h-full 2xl:inset-auto 2xl:left-0 2xl:right-0 2xl:top-auto 2xl:bottom-0 2xl:h-[calc(100%+(0.3*(100vw-1536px)))]"
  >
    <StaticBackground type="normal" />
    <FloatingElements type="normal" />
    <UfoSystem type="normal" />
  </div>

  <div
    class="absolute inset-0 w-full h-full pointer-events-none"
    style="clip-path: url(#scan-mask);"
  >
    <div
      class="inset-0 absolute w-full h-full 2xl:inset-auto 2xl:left-0 2xl:right-0 2xl:top-auto 2xl:bottom-0 2xl:h-[calc(100%+(0.3*(100vw-1536px)))]"
    >
      <StaticBackground type="pixel" />
      <FloatingElements type="pixel" />
      <UfoSystem type="pixel" />
    </div>
  </div>

  <ScannerUI />
  <div
    data-laser-target
    class="absolute left-1/2 top-1/2 w-2 h-2 bg-accent-500 rounded-full -translate-x-1/2 -translate-y-1/2 z-30"
  >
  </div>
  <div
    data-latent-logo
    data-speed="0.03"
    class="absolute left-1/2 top-20 w-[70%] md:w-[50%] lg:w-[40%] lg:left-[5%]"
  >
    <LatentLogo class="text-black -translate-x-1/2 lg:translate-x-0" />
  </div>

  <div
    data-log-wrapper
    class="absolute left-0 right-0 top-[50vh] z-30 h-[120vh]"
  >
    <Wavesection
      data-log-content
      position="top"
      class="inset-0 h-full px-[5%]"
    >
      <LogConsole />
    </Wavesection>
  </div>
</section>

<section
  class="w-full h-[150vh] p-[5%] text-white flex items-center justify-center text-4xl"
>
  我是下一個 Section (往下滾動時，上面的 Hero 會自然往上滑)
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { getHeroRoot, SELECTORS } from "./dom-registry";
  import { scanBoxes, floatElements } from "./hero-data";
  import { throttle } from "./hero-utils";
  import { initFloatParallax, initFloatSizes } from "./animations/parallax";
  import { initScannerAnimations } from "./animations/scanner";
  import { initLaserTarget, initLaserLines } from "./animations/laser";
  import { initUfoTracking } from "./animations/ufo";
  import { initTargetDropAnimation } from "./animations/story";
  import { initLogAnimations } from "./animations/logs";

  gsap.registerPlugin(ScrollTrigger);

  function initHeroParallax() {
    const heroSection = document.querySelector<HTMLElement>(SELECTORS.hero);
    if (!heroSection) return;

    const els = getHeroRoot(heroSection);

    const ctx = gsap.context(() => {
      const masterTl = gsap.timeline({
        scrollTrigger: {
          trigger: heroSection,
          start: "top top", // 畫布開始滾動時
          end: "bottom top", // 畫布完全離開視窗時
          scrub: true, // 綁定滾動條
        },
      });

      initFloatParallax(heroSection, [
        els.logo!,
        ...els.ufoWrappers,
        ...els.floatingEls,
      ]);

      const { updateSizes: scannerUpdate } = initScannerAnimations(
        heroSection,
        els.svg!,
        els.scanWrappers,
        scanBoxes,
      );

      const { updateSizes: floatUpdate } = initFloatSizes(
        els.floatingEls,
        floatElements,
      );

      function updateSizes() {
        scannerUpdate();
        floatUpdate();
        ScrollTrigger.refresh();
      }

      const cleanups: Array<() => void> = [];

      if (els.ufoWrappers.length > 0) {
        cleanups.push(initUfoTracking(els.ufoWrappers));
      }

      if (els.log.wrapper && els.log.content) {
        initTargetDropAnimation(masterTl, els.log.content);
        initLogAnimations(els.log.wrapper);
      }

      if (els.laserTarget && els.svg) {
        cleanups.push(initLaserTarget(els.laserTarget));
        initLaserLines(els.laserTarget, els.svg, els.scanWrappers);
      }

      const throttledResize = throttle(updateSizes, 200);
      window.addEventListener("resize", throttledResize);
      cleanups.push(() =>
        window.removeEventListener("resize", throttledResize),
      );

      updateSizes();

      return () => cleanups.forEach((fn) => fn());
    }, heroSection);

    document.addEventListener(
      "astro:before-swap",
      () => {
        ctx.revert();
      },
      { once: true },
    );
  }

  document.addEventListener("DOMContentLoaded", initHeroParallax);
</script>
