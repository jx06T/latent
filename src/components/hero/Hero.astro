---
import StaticBackground from "./StaticBackground.astro";
import FloatingElements from "./FloatingElements.astro";
import ScannerUI from "./ScannerUI.astro";
---

<section
  data-hero
  class="relative w-full h-[160vh] lg:h-[200vh] overflow-hidden bg-[#d18e12]"
>
  <StaticBackground />
  <FloatingElements type="normal" />

  <div
    class="absolute inset-0 w-full h-full pointer-events-none"
    style="clip-path: url(#scan-mask);"
  >
    <FloatingElements type="pixel" />
  </div>

  <ScannerUI />
  <div
    data-laser-target
    class="absolute left-1/2 top-1/2 w-2 h-2 bg-accent-500 rounded-full -translate-x-1/2 -translate-y-1/2 z-30"
  >
  </div>
</section>

<section
  class="w-full h-[150vh] p-32 bg-gray-900 text-white flex items-center justify-center text-4xl"
>
  我是下一個 Section (往下滾動時，上面的 Hero 會自然往上滑)
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { getHeroRoot, SELECTORS } from "./dom-registry";
  import { scanBoxes } from "./hero-data";
  import { debounce } from "./hero-utils";
  import { initFloatParallax } from "./animations/parallax";
  import { initScannerAnimations } from "./animations/scanner";
  import { initLaserTarget, initLaserLines } from "./animations/laser";

  gsap.registerPlugin(ScrollTrigger);

  function initHeroParallax() {
    const heroSection = document.querySelector<HTMLElement>(SELECTORS.hero);
    if (!heroSection) return;

    const els = getHeroRoot(heroSection);

    const ctx = gsap.context(() => {
      initFloatParallax(heroSection, els.floatingEls);

      const { updateSizes } = initScannerAnimations(
        heroSection,
        els.svg!,
        els.scanWrappers,
        scanBoxes
      );

      const cleanups: Array<() => void> = [];

      if (els.laserTarget && els.svg) {
        cleanups.push(initLaserTarget(els.laserTarget));
        initLaserLines(els.laserTarget, els.svg, els.scanWrappers);
      }

      const debouncedResize = debounce(updateSizes, 250);
      window.addEventListener("resize", debouncedResize);
      cleanups.push(() => window.removeEventListener("resize", debouncedResize));

      updateSizes();

      return () => cleanups.forEach((fn) => fn());
    }, heroSection);

    document.addEventListener(
      "astro:before-swap",
      () => { ctx.revert(); },
      { once: true }
    );
  }

  document.addEventListener("DOMContentLoaded", initHeroParallax);
</script>
