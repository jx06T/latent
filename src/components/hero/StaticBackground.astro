---
import { Image } from "astro:assets";
import bgLines from "@/assets/hero/bg-normal.jpg";
import bgPixels from "@/assets/hero/bg-pixel.jpg";

interface Props {
  type: "normal" | "pixel";
}

const { type } = Astro.props;
---

<div
  data-bg-static
  class="absolute inset-0 w-full h-full overflow-hidden"
>
  {
    type == "normal" ? (
      <Image
        src={bgLines}
        alt="Base Background"
        class="w-full h-full object-fill"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <Image
        src={bgPixels}
        alt="Pixel Background"
        class="w-full h-full object-fill"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
      />
    )
  }
</div>
