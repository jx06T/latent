---
import { Image } from "astro:assets";

// 假設你準備的圖片
import birdNormal from "@/assets/hero/bird-normal.png";
import birdPixel from "@/assets/hero/bird-pixel.png";

import fishNormal from "@/assets/hero/bird-normal.png";
import fishPixel from "@/assets/hero/bird-pixel.png";
// import fishNormal from "@/assets/hero/fish-normal.png";
// import fishPixel from "@/assets/hero/fish-pixel.png";

// 1. 定義你的「裝飾物清單」
// speed 說明：
//  0   = 原速 (貼在背景畫布上)
//  0.2 = 前景 (往下滾動時，它會往上飛得比較快，感覺離你較近)
// -0.1 = 中後景 (往下滾動時，它會往下掉一點點，感覺離你較遠)
const decorations = [
  {
    id: "bird-1",
    imgNormal: birdNormal,
    imgPixel: birdPixel,
    top: "15%",    // 垂直定位
    left: "70%",   // 水平定位
    width: "w-32", // Tailwind 寬度控制大小
    speed: 0.3,   // 視差速度 (正數 = 前景)
  },
  {
    id: "fish-1",
    imgNormal: fishNormal,
    imgPixel: fishPixel,
    top: "65%",
    left: "15%",
    width: "w-48",
    speed: 0.5,   // 視差速度 (負數 = 後景)
  },
];
---

<!-- 2. 自動迴圈渲染 -->
{decorations.map((item) => (
  <div
    class={`absolute ${item.width} pointer-events-none z-10 will-change-transform`}
    style={`top: ${item.top}; left: ${item.left};`}
    data-floating-element
    data-speed={item.speed}
  >
    <!-- Layer A: 原圖 -->
    <Image
      src={item.imgNormal}
      alt={item.id}
      class="w-full h-auto"
    />

    <!-- Layer B: 像素圖 (套用挖洞遮罩) -->
    <!-- absolute inset-0 確保它跟原圖 100% 完美重疊 -->
    <Image
      src={item.imgPixel}
      alt={`${item.id} pixel`}
      class="absolute inset-0 w-full h-auto"
      style="clip-path: url(#scan-mask);"
    />
  </div>
))}